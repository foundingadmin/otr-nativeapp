---
import Base from '../../layouts/Base.astro';

const SCALE = [
  { token: '--fs-72',  label: '72 — display',   sample: 'Aa' },
  { token: '--fs-56',  label: '56 — h1',         sample: 'Heading one' },
  { token: '--fs-36',  label: '36 — h2',         sample: 'Heading two' },
  { token: '--fs-28',  label: '28 — h3',         sample: 'Heading three' },
  { token: '--fs-24',  label: '24 — h4',         sample: 'Heading four' },
  { token: '--fs-20',  label: '20',              sample: 'Body large' },
  { token: '--fs-18',  label: '18 — subheading', sample: 'Subheading / body large' },
  { token: '--fs-16',  label: '16 — body',       sample: 'The quick brown fox jumps over the lazy dog' },
  { token: '--fs-14',  label: '14 — small',      sample: 'Small body text, labels, captions' },
  { token: '--fs-13',  label: '13 — caption',    sample: 'Caption, meta, helper text' },
  { token: '--fs-12',  label: '12 — micro',      sample: 'Micro labels, badges, timestamps' },
];

const WEIGHTS = [
  { token: '--fw-light',    value: '300', label: 'Light 300' },
  { token: '--fw-regular',  value: '400', label: 'Regular 400' },
  { token: '--fw-medium',   value: '500', label: 'Medium 500' },
  { token: '--fw-semibold', value: '600', label: 'Semibold 600' },
  { token: '--fw-bold',     value: '700', label: 'Bold 700' },
];

const LINE_HEIGHTS = [
  { token: '--lh-display', value: '0.95', note: 'Hero display type only' },
  { token: '--lh-tight',   value: '1.05', note: 'Headings h1–h3' },
  { token: '--lh-snug',    value: '1.2',  note: 'Headings h4, subheadings' },
  { token: '--lh-normal',  value: '1.45', note: 'Body default' },
  { token: '--lh-relaxed', value: '1.6',  note: 'Long-form reading, lead copy' },
];

const LETTER_SPACINGS = [
  { token: '--ls-display', value: '-0.035em', note: 'Hero / display size' },
  { token: '--ls-tight',   value: '-0.02em',  note: 'h1–h2 headings' },
  { token: '--ls-snug',    value: '-0.01em',  note: 'h3–h4 headings' },
  { token: '--ls-normal',  value: '0',        note: 'Body copy' },
  { token: '--ls-loose',   value: '0.04em',   note: 'Button labels' },
  { token: '--ls-wide',    value: '0.12em',   note: 'Uppercase eyebrows, tags' },
];
---

<Base title="Typography" currentPath="/foundations/typography">
  <header class="page-header">
    <p class="eyebrow">Foundations</p>
    <h1>Typography</h1>
    <p class="lead">
      Figtree variable (weight 300–700) is the sole typeface. All type tokens are CSS custom
      properties — never hardcode font sizes, weights, or letter spacing.
    </p>
  </header>

  <section class="token-section">
    <h2>Font families</h2>
    <div class="family-grid">
      <div class="family-card">
        <p class="family-sample sans-sample">Figtree</p>
        <div class="family-meta">
          <code>--font-sans</code>
          <span>UI, body, headings, buttons — all product surfaces</span>
        </div>
      </div>
      <div class="family-card">
        <p class="family-sample mono-sample">JetBrains Mono</p>
        <div class="family-meta">
          <code>--font-mono</code>
          <span>Code blocks, token names, developer docs</span>
        </div>
      </div>
    </div>
  </section>

  <section class="token-section">
    <h2>Type scale</h2>
    <div class="scale-list">
      {SCALE.map(row => (
        <div class="scale-row">
          <div class="scale-preview" style={`font-size: var(${row.token}); line-height: var(--lh-tight);`}>
            {row.sample}
          </div>
          <div class="scale-info">
            <code>{row.token}</code>
            <span>{row.label}</span>
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="token-section">
    <h2>Weights</h2>
    <div class="weight-list">
      {WEIGHTS.map(w => (
        <div class="weight-row">
          <span class="weight-sample" style={`font-weight: ${w.value};`}>
            The quick brown fox — {w.label}
          </span>
          <code>{w.token}</code>
        </div>
      ))}
    </div>
  </section>

  <section class="token-section">
    <h2>Line heights</h2>
    <div class="lh-grid">
      {LINE_HEIGHTS.map(lh => (
        <div class="lh-card">
          <p class="lh-sample" style={`line-height: var(${lh.token});`}>
            The quick brown fox jumps over the lazy dog and keeps on going
          </p>
          <div class="lh-meta">
            <code>{lh.token}</code>
            <span class="lh-value">{lh.value}</span>
            <span class="lh-note">{lh.note}</span>
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="token-section">
    <h2>Letter spacing</h2>
    <div class="ls-list">
      {LETTER_SPACINGS.map(ls => (
        <div class="ls-row">
          <span class="ls-sample" style={`letter-spacing: var(${ls.token});`}>
            Sample tracking
          </span>
          <div class="ls-meta">
            <code>{ls.token}</code>
            <span>{ls.value} — {ls.note}</span>
          </div>
        </div>
      ))}
    </div>
  </section>
</Base>

<style>
  /* Font families */
  .family-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4);
  }

  .family-card {
    background: var(--bg-subtle);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
  }

  .family-sample {
    font-size: var(--fs-36);
    font-weight: var(--fw-bold);
    letter-spacing: var(--ls-tight);
    margin: 0 0 var(--space-4);
    color: var(--fg-1);
  }

  .sans-sample { font-family: var(--font-sans); }
  .mono-sample { font-family: var(--font-mono); }

  .family-meta {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .family-meta code {
    font-size: var(--fs-13);
    color: var(--fg-accent);
  }

  .family-meta span {
    font-size: var(--fs-13);
    color: var(--fg-3);
  }

  /* Type scale */
  .scale-list {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .scale-row {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    padding: var(--space-4) var(--space-6);
    border-bottom: 1px solid var(--border-subtle);
  }

  .scale-row:last-child { border-bottom: none; }
  .scale-row:nth-child(even) { background: var(--bg-subtle); }

  .scale-preview {
    flex: 1;
    font-family: var(--font-sans);
    font-weight: var(--fw-semibold);
    color: var(--fg-1);
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .scale-info {
    flex-shrink: 0;
    text-align: right;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .scale-info code {
    font-size: var(--fs-13);
    color: var(--fg-accent);
  }

  .scale-info span {
    font-size: var(--fs-12);
    color: var(--fg-3);
  }

  /* Weights */
  .weight-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .weight-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-4) var(--space-5);
    background: var(--bg-subtle);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
  }

  .weight-sample {
    font-family: var(--font-sans);
    font-size: var(--fs-18);
    color: var(--fg-1);
  }

  .weight-row code {
    font-size: var(--fs-13);
    color: var(--fg-3);
    flex-shrink: 0;
  }

  /* Line heights */
  .lh-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: var(--space-4);
  }

  .lh-card {
    background: var(--bg-subtle);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: var(--space-5);
  }

  .lh-sample {
    font-size: var(--fs-14);
    color: var(--fg-1);
    margin: 0 0 var(--space-4);
  }

  .lh-meta {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .lh-meta code {
    font-size: var(--fs-13);
    color: var(--fg-accent);
  }

  .lh-value {
    font-size: var(--fs-13);
    font-family: var(--font-mono);
    color: var(--fg-2);
  }

  .lh-note {
    font-size: var(--fs-12);
    color: var(--fg-3);
  }

  /* Letter spacing */
  .ls-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .ls-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
    padding: var(--space-4) var(--space-5);
    background: var(--bg-subtle);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
  }

  .ls-sample {
    font-size: var(--fs-16);
    font-weight: var(--fw-semibold);
    color: var(--fg-1);
    text-transform: uppercase;
    white-space: nowrap;
  }

  .ls-meta {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    text-align: right;
    flex-shrink: 0;
  }

  .ls-meta code {
    font-size: var(--fs-13);
    color: var(--fg-accent);
  }

  .ls-meta span {
    font-size: var(--fs-12);
    color: var(--fg-3);
  }

  @media (max-width: 640px) {
    .family-grid { grid-template-columns: 1fr; }
    .scale-row { flex-direction: column; align-items: flex-start; gap: var(--space-2); }
    .scale-info { text-align: left; }
    .ls-row { flex-direction: column; align-items: flex-start; }
    .ls-meta { text-align: left; }
  }
</style>
