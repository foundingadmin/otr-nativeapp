---
import Base from '../../layouts/Base.astro';

const DURATIONS = [
  { token: '--dur-fast', ms: '120ms', label: 'Fast',  use: 'Micro-interactions, hover states, icon swaps' },
  { token: '--dur-base', ms: '200ms', label: 'Base',  use: 'Button transitions, panel reveals, state changes' },
  { token: '--dur-slow', ms: '320ms', label: 'Slow',  use: 'Modal open/close, sidebar slide, page transitions' },
];

const EASINGS = [
  { token: '--ease-standard',   curve: 'cubic-bezier(0.2, 0, 0, 1)',   label: 'Standard',   use: 'All transitions by default' },
  { token: '--ease-emphasized', curve: 'cubic-bezier(0.2, 0, 0, 1.2)', label: 'Emphasized', use: 'Attention-drawing moments — keep rare' },
  { token: '--ease-out',        curve: 'cubic-bezier(0, 0, 0, 1)',      label: 'Out',        use: 'Elements entering the viewport' },
];
---

<Base title="Motion" currentPath="/foundations/motion">
  <header class="page-header">
    <p class="eyebrow">Foundations</p>
    <h1>Motion</h1>
    <p class="lead">
      Three duration tiers (120 / 200 / 320 ms) and three easing curves. No spring overshoots,
      no bounces. All transitions reference <code>var(--ease-standard)</code> unless there is a
      specific reason to deviate.
    </p>
  </header>

  <section class="token-section">
    <h2>Duration tiers</h2>
    <div class="demo-grid">
      {DURATIONS.map(d => (
        <div class="demo-card" data-duration={d.token}>
          <div class="demo-stage">
            <div class="demo-ball"></div>
          </div>
          <div class="demo-meta">
            <div class="demo-top">
              <code>{d.token}</code>
              <span class="demo-ms">{d.ms}</span>
            </div>
            <p class="demo-use">{d.use}</p>
          </div>
          <button class="play-btn" type="button">Play</button>
        </div>
      ))}
    </div>
  </section>

  <section class="token-section">
    <h2>Easing curves</h2>
    <div class="easing-list">
      {EASINGS.map(e => (
        <div class="easing-row" data-easing={e.token}>
          <div class="easing-stage">
            <div class="easing-ball"></div>
          </div>
          <div class="easing-info">
            <div class="easing-top">
              <code>{e.token}</code>
              <span class="easing-label">{e.label}</span>
            </div>
            <span class="easing-curve">{e.curve}</span>
            <span class="easing-use">{e.use}</span>
          </div>
          <button class="play-btn" type="button">Play</button>
        </div>
      ))}
    </div>
  </section>

  <section class="token-section">
    <h2>Usage rules</h2>
    <div class="rules-list">
      <div class="rule-card">
        <h3>Default to standard</h3>
        <p>Use <code>var(--ease-standard)</code> + <code>var(--dur-base)</code> as your baseline.
           Deviating requires a clear reason — not preference.</p>
      </div>
      <div class="rule-card">
        <h3>Match tier to complexity</h3>
        <p>Fast (120ms) for simple hover swaps. Base (200ms) for state changes visible in flow.
           Slow (320ms) for panels and overlays that take visual space.</p>
      </div>
      <div class="rule-card">
        <h3>No overshoots in product UI</h3>
        <p><code>--ease-emphasized</code> has a slight overshoot (1.2). Reserve it for moments
           where you deliberately want to draw attention — not standard interactions.</p>
      </div>
      <div class="rule-card">
        <h3>Respect prefers-reduced-motion</h3>
        <p>Wrap any animation that moves content across distance in an
           <code>@media (prefers-reduced-motion: no-preference)</code> block,
           or set <code>transition-duration: 0.001ms</code> in a reduced-motion override.</p>
      </div>
    </div>
  </section>
</Base>

<style>
  /* Duration demos */
  .demo-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-4);
  }

  .demo-card {
    background: var(--bg-subtle);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .demo-stage {
    height: 48px;
    background: var(--bg-canvas);
    border-radius: var(--radius-md);
    border: 1px solid var(--border-subtle);
    position: relative;
    overflow: hidden;
  }

  .demo-ball {
    width: 24px;
    height: 24px;
    background: var(--fg-accent);
    border-radius: var(--radius-pill);
    position: absolute;
    top: 50%;
    left: var(--space-3);
    transform: translateY(-50%);
    transition-property: left;
    transition-timing-function: var(--ease-standard);
  }

  .demo-ball.playing { left: calc(100% - 24px - var(--space-3)); }

  .demo-meta {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .demo-top {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .demo-top code {
    font-size: var(--fs-13);
    color: var(--fg-accent);
  }

  .demo-ms {
    font-size: var(--fs-13);
    font-family: var(--font-mono);
    color: var(--fg-2);
    background: var(--bg-muted);
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-xs);
  }

  .demo-use {
    font-size: var(--fs-13);
    color: var(--fg-3);
    margin: 0;
    line-height: var(--lh-relaxed);
  }

  /* Easing demos */
  .easing-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .easing-row {
    display: grid;
    grid-template-columns: 200px 1fr auto;
    align-items: center;
    gap: var(--space-6);
    padding: var(--space-5);
    background: var(--bg-subtle);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
  }

  .easing-stage {
    height: 48px;
    background: var(--bg-canvas);
    border-radius: var(--radius-md);
    border: 1px solid var(--border-subtle);
    position: relative;
    overflow: hidden;
    flex-shrink: 0;
  }

  .easing-ball {
    width: 24px;
    height: 24px;
    background: var(--fg-accent);
    border-radius: var(--radius-pill);
    position: absolute;
    top: 50%;
    left: var(--space-3);
    transform: translateY(-50%);
    transition-property: left;
    transition-duration: var(--dur-base);
  }

  .easing-ball.playing { left: calc(100% - 24px - var(--space-3)); }

  .easing-info {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .easing-top {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .easing-top code {
    font-size: var(--fs-13);
    color: var(--fg-accent);
  }

  .easing-label {
    font-size: var(--fs-13);
    font-weight: var(--fw-semibold);
    color: var(--fg-2);
    background: var(--bg-muted);
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-xs);
  }

  .easing-curve {
    font-size: var(--fs-12);
    font-family: var(--font-mono);
    color: var(--fg-3);
  }

  .easing-use {
    font-size: var(--fs-13);
    color: var(--fg-3);
  }

  /* Play button (shared) */
  .play-btn {
    font-family: var(--font-sans);
    font-size: var(--fs-13);
    font-weight: var(--fw-semibold);
    padding: var(--space-2) var(--space-4);
    background: var(--bg-canvas);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-sm);
    color: var(--fg-2);
    cursor: pointer;
    flex-shrink: 0;
    transition: background var(--dur-fast) var(--ease-standard),
                color var(--dur-fast) var(--ease-standard);
    align-self: center;
  }

  .play-btn:hover {
    background: var(--bg-accent-soft);
    color: var(--fg-accent);
    border-color: var(--border-accent);
  }

  /* Usage rules */
  .rules-list {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4);
  }

  .rule-card {
    background: var(--bg-subtle);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: var(--space-5);
  }

  .rule-card h3 {
    font-size: var(--fs-14);
    font-weight: var(--fw-semibold);
    margin: 0 0 var(--space-2);
    color: var(--fg-1);
  }

  .rule-card p {
    font-size: var(--fs-14);
    color: var(--fg-2);
    line-height: var(--lh-relaxed);
    margin: 0;
  }

  @media (max-width: 640px) {
    .demo-grid { grid-template-columns: 1fr; }
    .easing-row { grid-template-columns: 1fr; }
    .rules-list { grid-template-columns: 1fr; }
  }
</style>

<script>
  const DURATIONS: Record<string, string> = {
    '--dur-fast': '120ms',
    '--dur-base': '200ms',
    '--dur-slow': '320ms',
  };

  document.querySelectorAll<HTMLElement>('.demo-card').forEach(card => {
    const token = card.dataset.duration ?? '--dur-base';
    const ball = card.querySelector<HTMLElement>('.demo-ball')!;
    const btn  = card.querySelector<HTMLButtonElement>('.play-btn')!;
    ball.style.transitionDuration = DURATIONS[token] ?? '200ms';

    btn.addEventListener('click', () => {
      ball.classList.remove('playing');
      void ball.offsetWidth; // reflow
      ball.classList.add('playing');
    });
  });

  const EASINGS: Record<string, string> = {
    '--ease-standard':   'cubic-bezier(0.2, 0, 0, 1)',
    '--ease-emphasized': 'cubic-bezier(0.2, 0, 0, 1.2)',
    '--ease-out':        'cubic-bezier(0, 0, 0, 1)',
  };

  document.querySelectorAll<HTMLElement>('.easing-row').forEach(row => {
    const token = row.dataset.easing ?? '--ease-standard';
    const ball  = row.querySelector<HTMLElement>('.easing-ball')!;
    const btn   = row.querySelector<HTMLButtonElement>('.play-btn')!;
    ball.style.transitionTimingFunction = EASINGS[token] ?? 'cubic-bezier(0.2, 0, 0, 1)';

    btn.addEventListener('click', () => {
      ball.classList.remove('playing');
      void ball.offsetWidth;
      ball.classList.add('playing');
    });
  });
</script>
