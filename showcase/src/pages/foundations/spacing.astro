---
import Base from '../../layouts/Base.astro';

const SPACE = [
  { token: '--space-1',  px: '4px' },
  { token: '--space-2',  px: '8px' },
  { token: '--space-3',  px: '12px' },
  { token: '--space-4',  px: '16px' },
  { token: '--space-5',  px: '20px' },
  { token: '--space-6',  px: '24px' },
  { token: '--space-8',  px: '32px' },
  { token: '--space-10', px: '40px' },
  { token: '--space-12', px: '48px' },
  { token: '--space-16', px: '64px' },
  { token: '--space-20', px: '80px' },
  { token: '--space-24', px: '96px' },
  { token: '--space-32', px: '128px' },
];

const RADII = [
  { token: '--radius-xs',   px: '2px',  label: 'XS' },
  { token: '--radius-sm',   px: '4px',  label: 'SM' },
  { token: '--radius-md',   px: '8px',  label: 'MD' },
  { token: '--radius-lg',   px: '12px', label: 'LG' },
  { token: '--radius-xl',   px: '16px', label: 'XL' },
  { token: '--radius-2xl',  px: '24px', label: '2XL' },
  { token: '--radius-pill', px: '999px', label: 'Pill' },
];

const SHADOWS = [
  { token: '--shadow-xs',    label: 'XS',    desc: 'Tooltips, micro-chips' },
  { token: '--shadow-sm',    label: 'SM',    desc: 'Cards, inputs, dropdowns' },
  { token: '--shadow-md',    label: 'MD',    desc: 'Popovers, floating panels' },
  { token: '--shadow-lg',    label: 'LG',    desc: 'Modals, sidebars' },
  { token: '--shadow-xl',    label: 'XL',    desc: 'Command palette, overlays' },
  { token: '--shadow-focus', label: 'Focus', desc: 'Keyboard focus ring — never for elevation' },
];

const BORDERS = [
  { token: '--border-thin',    px: '0.5px', desc: 'Hairline dividers, subtle separators' },
  { token: '--border-regular', px: '1px',   desc: 'Default borders — inputs, cards, panels' },
  { token: '--border-thick',   px: '2px',   desc: 'Emphasis borders — focus rings, active states' },
  { token: '--border-bar',     px: '12px',  desc: 'Accent bars — left-rail callouts, progress fills' },
];

const CONTAINERS = [
  { token: '--container-narrow',  px: '720px',  desc: 'Narrow reading column' },
  { token: '--container-default', px: '1120px', desc: 'Standard page content' },
  { token: '--container-wide',    px: '1440px', desc: 'Wide marketing / data layouts' },
];
---

<Base title="Spacing" currentPath="/foundations/spacing">
  <header class="page-header">
    <p class="eyebrow">Foundations</p>
    <h1>Spacing</h1>
    <p class="lead">
      4px base grid. All spacing, radii, shadows, border widths, and layout widths are CSS custom properties.
      Never hardcode pixel values — always use a token.
    </p>
  </header>

  <section class="token-section">
    <h2>Space scale</h2>
    <div class="space-list">
      {SPACE.map(s => (
        <div class="space-row">
          <code class="space-token">{s.token}</code>
          <span class="space-px">{s.px}</span>
          <div class="space-bar-wrap">
            <div class="space-bar" style={`width: var(${s.token}); min-width: 4px;`}></div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="token-section">
    <h2>Border radii</h2>
    <div class="radius-grid">
      {RADII.map(r => (
        <div class="radius-card">
          <div class="radius-swatch" style={`border-radius: var(${r.token});`}></div>
          <code>{r.token}</code>
          <span>{r.px}</span>
        </div>
      ))}
    </div>
  </section>

  <section class="token-section">
    <h2>Shadows</h2>
    <div class="shadow-grid">
      {SHADOWS.map(s => (
        <div class="shadow-card" style={`box-shadow: var(${s.token});`}>
          <div class="shadow-label">{s.label}</div>
          <code>{s.token}</code>
          <span>{s.desc}</span>
        </div>
      ))}
    </div>
  </section>

  <section class="token-section">
    <h2>Border widths</h2>
    <div class="border-list">
      {BORDERS.map(b => (
        <div class="border-row">
          <code class="border-token">{b.token}</code>
          <span class="border-px">{b.px}</span>
          <div class="border-swatch-wrap">
            <div class="border-swatch" style={`border-bottom-width: var(${b.token}); border-bottom-style: solid; border-bottom-color: var(--border-default);`}></div>
          </div>
          <span class="border-desc">{b.desc}</span>
        </div>
      ))}
    </div>
  </section>

  <section class="token-section">
    <h2>Layout widths</h2>
    <div class="container-list">
      {CONTAINERS.map(c => (
        <div class="container-row">
          <div class="container-info">
            <code>{c.token}</code>
            <span>{c.px} — {c.desc}</span>
          </div>
          <div class="container-bar-wrap">
            <div
              class="container-bar"
              style={`width: calc(var(${c.token}) / 1440px * 100%);`}
              title={c.px}
            ></div>
          </div>
        </div>
      ))}
    </div>
    <p class="container-note">
      Use <code>max-width: var(--container-default); margin-inline: auto;</code> to center content within the viewport.
    </p>
  </section>
</Base>

<style>
  /* Space scale */
  .space-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .space-row {
    display: grid;
    grid-template-columns: 180px 48px 1fr;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-2) 0;
  }

  .space-token {
    font-size: var(--fs-13);
    color: var(--fg-accent);
  }

  .space-px {
    font-size: var(--fs-13);
    color: var(--fg-3);
    font-family: var(--font-mono);
  }

  .space-bar-wrap {
    height: var(--space-4);
    background: var(--bg-muted);
    border-radius: var(--radius-sm);
    overflow: hidden;
  }

  .space-bar {
    height: 100%;
    background: var(--fg-accent);
    border-radius: var(--radius-sm);
    max-width: 100%;
  }

  /* Radii */
  .radius-grid {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  .radius-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-5);
    background: var(--bg-subtle);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    min-width: 96px;
  }

  .radius-swatch {
    width: 64px;
    height: 64px;
    background: var(--bg-accent-soft);
    border: 2px solid var(--border-accent);
  }

  .radius-card code {
    font-size: var(--fs-12);
    color: var(--fg-accent);
    text-align: center;
  }

  .radius-card span {
    font-size: var(--fs-12);
    color: var(--fg-3);
  }

  /* Shadows */
  .shadow-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: var(--space-6);
  }

  .shadow-card {
    background: var(--bg-canvas);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    border: 1px solid var(--border-subtle);
  }

  .shadow-label {
    font-size: var(--fs-22);
    font-weight: var(--fw-bold);
    color: var(--fg-1);
  }

  .shadow-card code {
    font-size: var(--fs-12);
    color: var(--fg-accent);
  }

  .shadow-card span {
    font-size: var(--fs-12);
    color: var(--fg-3);
  }

  /* Border widths */
  .border-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .border-row {
    display: grid;
    grid-template-columns: 180px 48px 120px 1fr;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-2) 0;
  }

  .border-token {
    font-size: var(--fs-13);
    color: var(--fg-accent);
  }

  .border-px {
    font-size: var(--fs-13);
    color: var(--fg-3);
    font-family: var(--font-mono);
  }

  .border-swatch-wrap {
    height: var(--space-5);
    display: flex;
    align-items: flex-end;
  }

  .border-swatch {
    width: 100%;
  }

  .border-desc {
    font-size: var(--fs-13);
    color: var(--fg-3);
  }

  /* Containers */
  .container-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .container-row {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .container-info {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  .container-info code {
    font-size: var(--fs-13);
    color: var(--fg-accent);
    white-space: nowrap;
  }

  .container-info span {
    font-size: var(--fs-13);
    color: var(--fg-3);
  }

  .container-bar-wrap {
    height: var(--space-3);
    background: var(--bg-muted);
    border-radius: var(--radius-pill);
    overflow: hidden;
  }

  .container-bar {
    height: 100%;
    background: var(--fg-accent);
    border-radius: var(--radius-pill);
    opacity: 0.6;
  }

  .container-note {
    margin-top: var(--space-4);
    font-size: var(--fs-13);
    color: var(--fg-3);
  }

  @media (max-width: 600px) {
    .space-row {
      grid-template-columns: 150px 40px 1fr;
    }
  }
</style>
