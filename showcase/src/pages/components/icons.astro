---
import Base from '../../layouts/Base.astro';

const ICONS = [
  'arrow-right', 'arrow-left', 'arrow-up', 'arrow-down',
  'check', 'x', 'plus', 'minus',
  'search', 'filter', 'settings', 'sliders-horizontal',
  'user', 'users', 'mail', 'phone',
  'file', 'file-text', 'folder', 'upload',
  'download', 'link', 'external-link', 'copy',
  'edit', 'trash-2', 'eye', 'eye-off',
  'info', 'alert-circle', 'alert-triangle', 'check-circle',
  'chevron-right', 'chevron-left', 'chevron-up', 'chevron-down',
  'menu', 'more-horizontal', 'more-vertical', 'grid',
  'home', 'layers', 'palette', 'type',
  'sun', 'moon', 'star', 'heart',
];
---

<Base title="Icons" currentPath="/components/icons">
  <header class="page-header">
    <p class="eyebrow">Components</p>
    <h1>Icons</h1>
    <p class="lead">
      Lucide icons only. Always 2px stroke, <code>currentColor</code>, no fill.
      Use 16px, 20px, or 24px — no other sizes.
    </p>
  </header>

  <div class="alert alert--info" role="note">
    <svg class="alert-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01"/></svg>
    <div class="alert-body">
      <strong class="alert-title">Browsing for an icon?</strong>
      <p class="alert-message">
        The full Lucide collection has 1,400+ icons. Browse and search at
        <a href="https://lucide.dev/icons/" class="alert-link" target="_blank" rel="noopener">lucide.dev/icons</a>
        — copy the icon name, then use it anywhere with <code>data-lucide="icon-name"</code>.
        The grid below shows a curated subset used across Brandforge.
      </p>
    </div>
  </div>

  <section class="demo-section">
    <h2>Icon grid</h2>
    <p class="section-desc">All icons rendered at 20px. Click to copy the Lucide name.</p>
    <div class="icon-grid" id="icon-grid">
      {ICONS.map(name => (
        <button class="icon-card" data-name={name} title={`Copy: ${name}`} type="button">
          <i data-lucide={name} class="lucide-icon"></i>
          <span class="icon-name">{name}</span>
          <span class="icon-copied">Copied</span>
        </button>
      ))}
    </div>
  </section>

  <section class="demo-section">
    <h2>Sizes</h2>
    <div class="size-demo">
      <div class="size-row">
        <div class="size-example">
          <i data-lucide="arrow-right" style="width:16px;height:16px;stroke-width:2;" class="lucide-icon"></i>
        </div>
        <div class="size-meta">
          <code>16px</code>
          <span>Inline in text, dense UI, table cells</span>
        </div>
      </div>
      <div class="size-row">
        <div class="size-example">
          <i data-lucide="arrow-right" style="width:20px;height:20px;stroke-width:2;" class="lucide-icon"></i>
        </div>
        <div class="size-meta">
          <code>20px</code>
          <span>Default — nav, buttons, most UI contexts</span>
        </div>
      </div>
      <div class="size-row">
        <div class="size-example">
          <i data-lucide="arrow-right" style="width:24px;height:24px;stroke-width:2;" class="lucide-icon"></i>
        </div>
        <div class="size-meta">
          <code>24px</code>
          <span>Hero moments, section headers, empty states</span>
        </div>
      </div>
    </div>
  </section>

  <section class="demo-section">
    <h2>Usage guidelines</h2>
    <div class="rules-grid">
      <div class="rule-card">
        <h3>Import</h3>
        <pre class="code-block">&lt;script src="https://unpkg.com/lucide@latest"&gt;&lt;/script&gt;
&lt;script&gt;lucide.createIcons();&lt;/script&gt;</pre>
        <p>Or install: <code>npm install lucide</code> and import named SVGs in your framework.</p>
      </div>
      <div class="rule-card">
        <h3>HTML usage</h3>
        <pre class="code-block">&lt;i data-lucide="arrow-right"
   style="width:20px;height:20px"&gt;
&lt;/i&gt;</pre>
        <p>Always specify width and height. Stroke width is 2 by default — do not override.</p>
      </div>
      <div class="rule-card">
        <h3>Color</h3>
        <p>Icons inherit <code>color</code> via <code>currentColor</code> on the stroke.
           To set an icon color, set <code>color</code> on the parent element or directly:
           <code>style="color: var(--fg-accent)"</code></p>
      </div>
      <div class="rule-card">
        <h3>Accessibility</h3>
        <p>Decorative icons (next to visible text): add <code>aria-hidden="true"</code>.<br/>
           Standalone icons (no visible label): add <code>aria-label="Description"</code>
           to the wrapping button or use a visually-hidden span.</p>
      </div>
    </div>
  </section>
</Base>

<script src="https://unpkg.com/lucide@latest/dist/umd/lucide.min.js"></script>

<style>
  /* Alert (info variant for icon browsing callout) */
  .alert {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    padding: var(--space-4);
    border-radius: var(--radius-md);
    border: 1px solid transparent;
    margin-bottom: var(--space-8);
  }
  .alert--info {
    background: var(--color-info-200);
    border-color: var(--color-info-400);
    color: var(--color-info-800);
  }
  [data-theme="dark"] .alert--info {
    background: rgba(124,91,217,0.18);
    border-color: rgba(124,91,217,0.35);
    color: var(--color-info-400);
  }
  .alert-icon { flex-shrink: 0; margin-top: 1px; }
  .alert-body { flex: 1; font-family: var(--font-sans); font-size: var(--fs-14); }
  .alert-title { display: block; font-weight: var(--fw-semibold); margin-bottom: var(--space-1); }
  .alert-message { margin: 0; opacity: 0.9; line-height: var(--lh-relaxed); }
  .alert-link {
    color: inherit;
    font-weight: var(--fw-semibold);
    text-underline-offset: 2px;
  }
  .alert-link:hover { opacity: 0.8; }

  .section-desc {
    font-size: var(--fs-14);
    color: var(--fg-3);
    margin: 0 0 var(--space-5);
  }

  /* Icon grid */
  .icon-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(96px, 1fr));
    gap: var(--space-2);
  }

  .icon-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-4) var(--space-2);
    background: var(--bg-subtle);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    cursor: pointer;
    font-family: var(--font-sans);
    position: relative;
    transition: background var(--dur-fast) var(--ease-standard),
                border-color var(--dur-fast) var(--ease-standard);
  }

  .icon-card:hover {
    background: var(--bg-accent-soft);
    border-color: var(--border-accent);
  }

  .lucide-icon {
    width: 20px;
    height: 20px;
    color: var(--fg-1);
    display: block;
  }

  .icon-name {
    font-size: var(--fs-12);
    color: var(--fg-3);
    text-align: center;
    line-height: var(--lh-snug);
    word-break: break-all;
  }

  .icon-copied {
    position: absolute;
    top: var(--space-2);
    right: var(--space-2);
    background: var(--fg-accent);
    color: var(--bg-canvas);
    font-size: var(--fs-12);
    font-weight: var(--fw-semibold);
    padding: 2px var(--space-2);
    border-radius: var(--radius-xs);
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--dur-fast) var(--ease-standard);
  }

  .icon-card.just-copied .icon-copied { opacity: 1; }

  /* Sizes */
  .size-demo {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .size-row {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    padding: var(--space-4) var(--space-5);
    background: var(--bg-subtle);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
  }

  .size-example {
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .size-meta {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .size-meta code {
    font-size: var(--fs-14);
    color: var(--fg-accent);
  }

  .size-meta span {
    font-size: var(--fs-14);
    color: var(--fg-2);
  }

  /* Rules */
  .rules-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4);
  }

  .rule-card {
    background: var(--bg-subtle);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: var(--space-5);
  }

  .rule-card h3 {
    font-size: var(--fs-14);
    font-weight: var(--fw-semibold);
    margin: 0 0 var(--space-3);
    color: var(--fg-1);
  }

  .rule-card p {
    font-size: var(--fs-14);
    color: var(--fg-2);
    line-height: var(--lh-relaxed);
    margin: var(--space-3) 0 0;
  }

  @media (max-width: 640px) {
    .rules-grid { grid-template-columns: 1fr; }
  }
</style>

<script>
  if (typeof (window as any).lucide !== 'undefined') {
    (window as any).lucide.createIcons();
  } else {
    document.currentScript?.closest('body')
      ?.querySelector<HTMLScriptElement>('script[src*="lucide"]')
      ?.addEventListener('load', () => (window as any).lucide?.createIcons());
  }

  document.querySelectorAll<HTMLButtonElement>('.icon-card').forEach(card => {
    card.addEventListener('click', async () => {
      const name = card.dataset.name ?? '';
      try {
        await navigator.clipboard.writeText(name);
      } catch {
        const ta = document.createElement('textarea');
        ta.value = name;
        document.body.appendChild(ta);
        ta.select();
        document.execCommand('copy');
        document.body.removeChild(ta);
      }
      card.classList.add('just-copied');
      setTimeout(() => card.classList.remove('just-copied'), 1200);
    });
  });
</script>
