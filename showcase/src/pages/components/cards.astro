---
import Base from '../../layouts/Base.astro';
---

<Base title="Cards" currentPath="/components/cards">
  <header class="page-header">
    <p class="eyebrow">Components</p>
    <h1>Cards</h1>
    <p class="lead">
      Cards group related content in a bounded container. Use elevation (shadow) to signal
      interactivity — static information cards use a border, not a shadow.
    </p>
  </header>

  <section class="demo-section">
    <h2>Basic card</h2>
    <div class="demo-surface">
      <div class="card">
        <h3 class="card-title">Card title</h3>
        <p class="card-body">
          Supporting text that describes what this card is about. Keep it concise — two lines maximum before truncating or expanding.
        </p>
      </div>
    </div>
    <pre class="code-block">&lt;div class="card"&gt;
  &lt;h3 class="card-title"&gt;Card title&lt;/h3&gt;
  &lt;p class="card-body"&gt;Supporting text.&lt;/p&gt;
&lt;/div&gt;</pre>
  </section>

  <section class="demo-section">
    <h2>Card with header and footer</h2>
    <div class="demo-surface">
      <div class="card card--structured">
        <div class="card-header">
          <div class="card-header-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M3 9h18"/><path d="M9 21V9"/></svg>
          </div>
          <div>
            <h3 class="card-title">Design tokens</h3>
            <p class="card-subtitle">165 tokens across 5 categories</p>
          </div>
        </div>
        <div class="card-content">
          <p class="card-body">
            Color primitives, semantic aliases, typography, spacing, and motion — all versioned and synced with Figma.
          </p>
        </div>
        <div class="card-footer">
          <button class="btn-link">View tokens</button>
          <button class="btn-link btn-link--primary">Open in Figma</button>
        </div>
      </div>
    </div>
    <pre class="code-block">&lt;div class="card card--structured"&gt;
  &lt;div class="card-header"&gt;...&lt;/div&gt;
  &lt;div class="card-content"&gt;...&lt;/div&gt;
  &lt;div class="card-footer"&gt;...&lt;/div&gt;
&lt;/div&gt;</pre>
  </section>

  <section class="demo-section">
    <h2>Interactive card (hover elevation)</h2>
    <div class="demo-surface">
      <div class="card-grid">
        <a href="#" class="card card--interactive">
          <div class="card-icon-wrap">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 8v4"/><path d="M12 16h.01"/></svg>
          </div>
          <h3 class="card-title">Quick start</h3>
          <p class="card-body">Get Brandforge running in under 10 minutes.</p>
        </a>
        <a href="#" class="card card--interactive">
          <div class="card-icon-wrap">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14.5 4h-5L7 7H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-3L14.5 4z"/><circle cx="12" cy="13" r="3"/></svg>
          </div>
          <h3 class="card-title">Templates</h3>
          <p class="card-body">Browse AI-ready templates for every content type.</p>
        </a>
        <a href="#" class="card card--interactive">
          <div class="card-icon-wrap">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
          </div>
          <h3 class="card-title">Token API</h3>
          <p class="card-body">All 165 tokens as CSS custom properties, JSON, and more.</p>
        </a>
      </div>
    </div>
    <pre class="code-block">&lt;!-- Use an &lt;a&gt; for linked cards; &lt;button&gt; for action cards --&gt;
&lt;a href="/path" class="card card--interactive"&gt;
  &lt;h3 class="card-title"&gt;...&lt;/h3&gt;
  &lt;p class="card-body"&gt;...&lt;/p&gt;
&lt;/a&gt;</pre>
  </section>

  <section class="demo-section">
    <h2>Elevation guidance</h2>
    <div class="elevation-row">
      <div class="elevation-card flat">
        <span class="elevation-label">Flat</span>
        <code>border: 1px solid var(--border-subtle)</code>
        <span class="elevation-use">Static information. No hover state.</span>
      </div>
      <div class="elevation-card raised">
        <span class="elevation-label">Raised</span>
        <code>box-shadow: var(--shadow-sm)</code>
        <span class="elevation-use">Interactive on hover. Signals clickability.</span>
      </div>
      <div class="elevation-card floating">
        <span class="elevation-label">Floating</span>
        <code>box-shadow: var(--shadow-md)</code>
        <span class="elevation-use">Popovers, dropdowns, floating panels.</span>
      </div>
    </div>
  </section>
</Base>

<style>
  /* cards page: demo-surface centers its content (differs from default) */
  .demo-surface {
    background: var(--bg-muted);
    display: flex;
    justify-content: center;
  }

  /* Card base */
  .card {
    background: var(--bg-canvas);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    max-width: 400px;
    width: 100%;
  }

  .card-title {
    font-size: var(--fs-16);
    font-weight: var(--fw-semibold);
    color: var(--fg-1);
    margin: 0 0 var(--space-2);
    letter-spacing: var(--ls-snug);
    line-height: var(--lh-tight);
  }

  .card-subtitle {
    font-size: var(--fs-13);
    color: var(--fg-3);
    margin: 0;
  }

  .card-body {
    font-size: var(--fs-14);
    color: var(--fg-2);
    line-height: var(--lh-relaxed);
    margin: 0;
  }

  /* Structured card */
  .card--structured {
    padding: 0;
    overflow: hidden;
  }

  .card-header {
    display: flex;
    align-items: flex-start;
    gap: var(--space-4);
    padding: var(--space-5) var(--space-6);
    border-bottom: 1px solid var(--border-subtle);
  }

  .card-header-icon {
    width: 40px;
    height: 40px;
    background: var(--bg-accent-soft);
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--fg-accent);
    flex-shrink: 0;
  }

  .card-content {
    padding: var(--space-5) var(--space-6);
  }

  .card-footer {
    display: flex;
    gap: var(--space-3);
    padding: var(--space-4) var(--space-6);
    border-top: 1px solid var(--border-subtle);
    background: var(--bg-subtle);
  }

  .btn-link {
    font-family: var(--font-sans);
    font-size: var(--fs-14);
    font-weight: var(--fw-medium);
    color: var(--fg-2);
    background: none;
    border: none;
    cursor: pointer;
    padding: var(--space-1) 0;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .btn-link--primary { color: var(--fg-accent); }

  /* Interactive card */
  .card--interactive {
    text-decoration: none;
    cursor: pointer;
    transition: box-shadow var(--dur-fast) var(--ease-standard),
                border-color var(--dur-fast) var(--ease-standard),
                transform var(--dur-fast) var(--ease-standard);
  }

  .card--interactive:hover {
    box-shadow: var(--shadow-md);
    border-color: var(--border-default);
    transform: translateY(-2px);
    text-decoration: none;
  }

  .card-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-4);
    width: 100%;
    max-width: 680px;
  }

  .card-icon-wrap {
    width: 40px;
    height: 40px;
    background: var(--bg-accent-soft);
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--fg-accent);
    margin-bottom: var(--space-4);
  }

  .card--interactive .card-title {
    font-size: var(--fs-15);
    margin-bottom: var(--space-2);
  }

  /* Elevation cards */
  .elevation-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6);
    padding: var(--space-8) 0;
  }

  .elevation-card {
    background: var(--bg-canvas);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .flat    { border: 1px solid var(--border-subtle); }
  .raised  { box-shadow: var(--shadow-sm); border: 1px solid transparent; }
  .floating{ box-shadow: var(--shadow-md); border: 1px solid transparent; }

  .elevation-label {
    font-size: var(--fs-14);
    font-weight: var(--fw-semibold);
    color: var(--fg-1);
  }

  .elevation-card code {
    font-size: var(--fs-12);
    color: var(--fg-accent);
    word-break: break-all;
  }

  .elevation-use {
    font-size: var(--fs-13);
    color: var(--fg-3);
  }

  @media (max-width: 640px) {
    .card-grid { grid-template-columns: 1fr; }
    .elevation-row { grid-template-columns: 1fr; }
    .demo-surface { padding: var(--space-5); }
  }
</style>
