---
import Base from '../../layouts/Base.astro';
---

<Base title="Molecules" currentPath="/components/molecules">
  <header class="page-header">
    <p class="eyebrow">Components</p>
    <h1>Molecules</h1>
    <p class="lead">
      Composed UI patterns built from atoms: alerts, breadcrumbs, pagination, and tabs.
      All use semantic color tokens. Interactive patterns (tabs) use minimal vanilla JS
      with no framework dependency.
    </p>
  </header>

  <!-- ── Alert ────────────────────────────────────────────── -->
  <section class="demo-section">
    <h2>Alert</h2>
    <p class="demo-note">
      Inline feedback messages. Four semantic variants map to brand status colors.
      Use the dismiss variant when the user can clear the message.
    </p>
    <div class="demo-surface demo-surface--stack">
      <div class="alert alert--info" role="alert">
        <svg class="alert-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01"/></svg>
        <div class="alert-body">
          <strong class="alert-title">Heads up</strong>
          <p class="alert-message">Your session will expire in 10 minutes. Save your work.</p>
        </div>
      </div>
      <div class="alert alert--success" role="alert">
        <svg class="alert-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
        <div class="alert-body">
          <strong class="alert-title">Changes saved</strong>
          <p class="alert-message">Your token updates have been committed and pushed.</p>
        </div>
      </div>
      <div class="alert alert--warning" role="alert">
        <svg class="alert-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><path d="M12 9v4M12 17h.01"/></svg>
        <div class="alert-body">
          <strong class="alert-title">Sync mismatch</strong>
          <p class="alert-message">Two tokens in Figma differ from the source JSON. Review before committing.</p>
        </div>
      </div>
      <div class="alert alert--error" role="alert">
        <svg class="alert-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="m15 9-6 6M9 9l6 6"/></svg>
        <div class="alert-body">
          <strong class="alert-title">Build failed</strong>
          <p class="alert-message">The Astro build reported 3 errors. Check the output log.</p>
        </div>
        <button type="button" class="alert-dismiss" aria-label="Dismiss alert">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>
        </button>
      </div>
    </div>
    <pre class="code-block">&lt;div class="alert alert--info" role="alert"&gt;
  &lt;svg class="alert-icon" ...&gt;&lt;/svg&gt;
  &lt;div class="alert-body"&gt;
    &lt;strong class="alert-title"&gt;Title&lt;/strong&gt;
    &lt;p class="alert-message"&gt;Description.&lt;/p&gt;
  &lt;/div&gt;
&lt;/div&gt;

&lt;!-- Variants: alert--info | alert--success | alert--warning | alert--error --&gt;
&lt;!-- Add dismiss button if dismissible --&gt;</pre>
  </section>

  <!-- ── Breadcrumb ────────────────────────────────────────── -->
  <section class="demo-section">
    <h2>Breadcrumb</h2>
    <p class="demo-note">
      Wayfinding trail. The last item is the current page — mark it
      <code>aria-current="page"</code> and do not wrap it in an anchor.
    </p>
    <div class="demo-surface">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <ol class="breadcrumb-list">
          <li class="breadcrumb-item">
            <a href="#" class="breadcrumb-link">Home</a>
          </li>
          <li class="breadcrumb-item" aria-hidden="true">
            <span class="breadcrumb-sep">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
            </span>
          </li>
          <li class="breadcrumb-item">
            <a href="#" class="breadcrumb-link">Components</a>
          </li>
          <li class="breadcrumb-item" aria-hidden="true">
            <span class="breadcrumb-sep">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
            </span>
          </li>
          <li class="breadcrumb-item">
            <span class="breadcrumb-current" aria-current="page">Molecules</span>
          </li>
        </ol>
      </nav>
    </div>
    <pre class="code-block">&lt;nav class="breadcrumb" aria-label="Breadcrumb"&gt;
  &lt;ol class="breadcrumb-list"&gt;
    &lt;li class="breadcrumb-item"&gt;
      &lt;a href="/" class="breadcrumb-link"&gt;Home&lt;/a&gt;
    &lt;/li&gt;
    &lt;li class="breadcrumb-item" aria-hidden="true"&gt;
      &lt;span class="breadcrumb-sep"&gt;&lt;svg ...&gt;&lt;/svg&gt;&lt;/span&gt;
    &lt;/li&gt;
    &lt;li class="breadcrumb-item"&gt;
      &lt;span class="breadcrumb-current" aria-current="page"&gt;Current page&lt;/span&gt;
    &lt;/li&gt;
  &lt;/ol&gt;
&lt;/nav&gt;</pre>
  </section>

  <!-- ── Pagination ────────────────────────────────────────── -->
  <section class="demo-section">
    <h2>Pagination</h2>
    <p class="demo-note">
      Page navigation for long lists. The active page uses <code>aria-current="page"</code>.
      Disabled prev/next use <code>aria-disabled="true"</code>.
    </p>
    <div class="demo-surface">
      <nav class="pagination" aria-label="Page navigation">
        <button type="button" class="page-btn page-btn--nav" aria-disabled="true" disabled>
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
          <span class="sr-only">Previous</span>
        </button>
        <button type="button" class="page-btn page-btn--active" aria-current="page">1</button>
        <button type="button" class="page-btn">2</button>
        <button type="button" class="page-btn">3</button>
        <span class="page-ellipsis" aria-hidden="true">…</span>
        <button type="button" class="page-btn">12</button>
        <button type="button" class="page-btn page-btn--nav">
          <span class="sr-only">Next</span>
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
        </button>
      </nav>
    </div>
    <pre class="code-block">&lt;nav class="pagination" aria-label="Page navigation"&gt;
  &lt;button type="button" class="page-btn page-btn--nav" disabled&gt;
    &lt;svg ...&gt;&lt;/svg&gt;
  &lt;/button&gt;
  &lt;button type="button" class="page-btn page-btn--active" aria-current="page"&gt;1&lt;/button&gt;
  &lt;button type="button" class="page-btn"&gt;2&lt;/button&gt;
  &lt;span class="page-ellipsis" aria-hidden="true"&gt;…&lt;/span&gt;
  &lt;button type="button" class="page-btn page-btn--nav"&gt;
    &lt;svg ...&gt;&lt;/svg&gt;
  &lt;/button&gt;
&lt;/nav&gt;</pre>
  </section>

  <!-- ── Tabs ──────────────────────────────────────────────── -->
  <section class="demo-section">
    <h2>Tabs</h2>
    <p class="demo-note">
      Tabbed content panels. Uses <code>role="tablist"</code> / <code>role="tab"</code> /
      <code>role="tabpanel"</code> for full ARIA semantics. JS toggles
      <code>aria-selected</code> and panel visibility on click.
    </p>
    <div class="demo-surface">
      <div class="tabs" id="demo-tabs">
        <div class="tab-list" role="tablist" aria-label="Demo tabs">
          <button type="button" role="tab" class="tab tab--active" aria-selected="true" aria-controls="panel-overview" id="tab-overview">Overview</button>
          <button type="button" role="tab" class="tab" aria-selected="false" aria-controls="panel-tokens" id="tab-tokens" tabindex="-1">Tokens</button>
          <button type="button" role="tab" class="tab" aria-selected="false" aria-controls="panel-usage" id="tab-usage" tabindex="-1">Usage</button>
        </div>
        <div class="tab-panel" role="tabpanel" id="panel-overview" aria-labelledby="tab-overview">
          <p>Overview content. This panel is active by default.</p>
        </div>
        <div class="tab-panel" role="tabpanel" id="panel-tokens" aria-labelledby="tab-tokens" hidden>
          <p>Tokens content. CSS custom properties used in this component.</p>
        </div>
        <div class="tab-panel" role="tabpanel" id="panel-usage" aria-labelledby="tab-usage" hidden>
          <p>Usage guidelines and accessibility notes.</p>
        </div>
      </div>
    </div>
    <pre class="code-block">&lt;div class="tabs"&gt;
  &lt;div class="tab-list" role="tablist" aria-label="Section tabs"&gt;
    &lt;button type="button" role="tab" class="tab tab--active"
      aria-selected="true" aria-controls="panel-a" id="tab-a"&gt;Tab A&lt;/button&gt;
    &lt;button type="button" role="tab" class="tab"
      aria-selected="false" aria-controls="panel-b" id="tab-b" tabindex="-1"&gt;Tab B&lt;/button&gt;
  &lt;/div&gt;
  &lt;div class="tab-panel" role="tabpanel" id="panel-a" aria-labelledby="tab-a"&gt;
    Content A
  &lt;/div&gt;
  &lt;div class="tab-panel" role="tabpanel" id="panel-b" aria-labelledby="tab-b" hidden&gt;
    Content B
  &lt;/div&gt;
&lt;/div&gt;</pre>
  </section>
</Base>

<style>
  /* ── Alert ───────────────────────────────────────────────── */
  .demo-surface--stack {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .alert {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    padding: var(--space-4);
    border-radius: var(--radius-md);
    border: 1px solid var(--border-subtle);
    background: var(--bg-muted);
  }

  .alert--info {
    background: var(--color-info-200);
    border-color: var(--color-info-400);
    color: var(--color-info-800);
  }
  .alert--success {
    background: var(--color-success-200);
    border-color: var(--color-success-400);
    color: var(--color-success-800);
  }
  .alert--warning {
    background: var(--color-warning-200);
    border-color: var(--color-warning-400);
    color: var(--color-warning-800);
  }
  .alert--error {
    background: var(--color-error-200);
    border-color: var(--color-error-400);
    color: var(--color-error-800);
  }

  .alert-icon {
    flex-shrink: 0;
    margin-top: 1px;
  }

  .alert-body {
    flex: 1;
    min-width: 0;
  }

  .alert-title {
    display: block;
    font-family: var(--font-sans);
    font-size: var(--fs-14);
    font-weight: var(--fw-semibold);
    margin-bottom: var(--space-1);
  }

  .alert-message {
    font-family: var(--font-sans);
    font-size: var(--fs-14);
    margin: 0;
    opacity: 0.88;
  }

  .alert-dismiss {
    flex-shrink: 0;
    background: none;
    border: none;
    cursor: pointer;
    color: currentColor;
    opacity: 0.6;
    padding: var(--space-1);
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    transition: opacity var(--dur-fast) var(--ease-standard),
                background var(--dur-fast) var(--ease-standard);
    margin-top: -2px;
  }
  .alert-dismiss:hover { opacity: 1; background: rgba(0,0,0,0.06); }
  .alert-dismiss:focus-visible { outline: none; box-shadow: var(--shadow-focus); }

  /* Dark mode alerts */
  [data-theme="dark"] .alert--info {
    background: rgba(124,91,217,0.2);
    border-color: rgba(124,91,217,0.35);
    color: var(--color-info-400);
  }
  [data-theme="dark"] .alert--success {
    background: rgba(46,158,110,0.2);
    border-color: rgba(46,158,110,0.35);
    color: var(--color-success-400);
  }
  [data-theme="dark"] .alert--warning {
    background: rgba(233,162,59,0.2);
    border-color: rgba(233,162,59,0.35);
    color: var(--color-warning-400);
  }
  [data-theme="dark"] .alert--error {
    background: rgba(214,73,47,0.2);
    border-color: rgba(214,73,47,0.35);
    color: var(--color-error-400);
  }

  /* ── Breadcrumb ──────────────────────────────────────────── */
  .breadcrumb-list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .breadcrumb-item {
    display: flex;
    align-items: center;
  }

  .breadcrumb-link {
    font-family: var(--font-sans);
    font-size: var(--fs-14);
    color: var(--fg-link);
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease-standard);
  }
  .breadcrumb-link:hover { color: var(--fg-link-hover); text-decoration: underline; }

  .breadcrumb-sep {
    display: inline-flex;
    align-items: center;
    color: var(--fg-4);
    padding: 0 var(--space-1);
  }

  .breadcrumb-current {
    font-family: var(--font-sans);
    font-size: var(--fs-14);
    color: var(--fg-2);
    font-weight: var(--fw-medium);
  }

  /* ── Pagination ──────────────────────────────────────────── */
  .pagination {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    flex-wrap: wrap;
  }

  .page-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 36px;
    height: 36px;
    padding: 0 var(--space-2);
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-default);
    background: var(--bg-canvas);
    color: var(--fg-2);
    font-family: var(--font-sans);
    font-size: var(--fs-14);
    font-weight: var(--fw-medium);
    cursor: pointer;
    transition: background var(--dur-fast) var(--ease-standard),
                color var(--dur-fast) var(--ease-standard),
                border-color var(--dur-fast) var(--ease-standard);
  }

  .page-btn:hover:not(:disabled) {
    background: var(--bg-muted);
    border-color: var(--border-strong);
    color: var(--fg-1);
  }

  .page-btn--active {
    background: var(--btn-primary-bg);
    border-color: var(--btn-primary-bg);
    color: var(--btn-primary-text);
  }
  .page-btn--active:hover:not(:disabled) {
    background: var(--btn-primary-bg-hover);
    border-color: var(--btn-primary-bg-hover);
    color: var(--btn-primary-text);
  }

  .page-btn--nav {
    color: var(--fg-3);
  }

  .page-btn:disabled {
    background: var(--bg-muted);
    color: var(--fg-4);
    border-color: var(--border-subtle);
    cursor: not-allowed;
  }

  .page-btn:focus-visible {
    outline: none;
    box-shadow: var(--shadow-focus);
  }

  .page-ellipsis {
    font-family: var(--font-sans);
    font-size: var(--fs-14);
    color: var(--fg-4);
    padding: 0 var(--space-2);
    user-select: none;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0,0,0,0);
    white-space: nowrap;
  }

  /* ── Tabs ────────────────────────────────────────────────── */
  .tabs {
    border: 1px solid var(--border-default);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .tab-list {
    display: flex;
    border-bottom: 1px solid var(--border-default);
    background: var(--bg-subtle);
    overflow-x: auto;
  }

  .tab {
    flex-shrink: 0;
    padding: var(--space-3) var(--space-5);
    font-family: var(--font-sans);
    font-size: var(--fs-14);
    font-weight: var(--fw-medium);
    color: var(--fg-3);
    background: none;
    border: none;
    border-bottom: 2px solid transparent;
    cursor: pointer;
    transition: color var(--dur-fast) var(--ease-standard),
                border-color var(--dur-fast) var(--ease-standard),
                background var(--dur-fast) var(--ease-standard);
    margin-bottom: -1px;
  }

  .tab:hover {
    color: var(--fg-1);
    background: var(--bg-muted);
  }

  .tab--active,
  .tab[aria-selected="true"] {
    color: var(--fg-accent);
    border-bottom-color: var(--border-accent);
    background: var(--bg-canvas);
  }

  .tab:focus-visible {
    outline: none;
    box-shadow: inset var(--shadow-focus);
  }

  .tab-panel {
    padding: var(--space-6);
    font-family: var(--font-sans);
    font-size: var(--fs-14);
    color: var(--fg-2);
    line-height: 1.6;
  }

  .tab-panel p { margin: 0; }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.tabs').forEach(tabs => {
    const tabBtns = Array.from(tabs.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    tabBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        tabBtns.forEach(t => {
          t.setAttribute('aria-selected', 'false');
          t.classList.remove('tab--active');
          t.setAttribute('tabindex', '-1');
          const panel = tabs.querySelector<HTMLElement>(`#${t.getAttribute('aria-controls')}`);
          if (panel) panel.hidden = true;
        });
        btn.setAttribute('aria-selected', 'true');
        btn.classList.add('tab--active');
        btn.setAttribute('tabindex', '0');
        const activePanel = tabs.querySelector<HTMLElement>(`#${btn.getAttribute('aria-controls')}`);
        if (activePanel) activePanel.hidden = false;
      });
    });
  });
</script>
