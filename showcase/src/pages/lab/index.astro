---
import Base from '../../layouts/Base.astro';

// Auto-discover all HTML files in showcase/public/lab/
const labGlob = import.meta.glob('../../../public/lab/*.html', { query: '?raw', import: 'default', eager: true }) as Record<string, string>;

interface LabMeta {
  title: string;
  type: string;
  date: string;
  description: string;
  author: string;
  filename: string;
  href: string;
}

const TYPE_LABELS: Record<string, string> = {
  landing:    'Landing page',
  onesheet:   'One-sheet',
  email:      'Email template',
  ad:         'Ad creative',
  deck:       'Deck',
  experiment: 'Experiment',
};

function parseMeta(raw: string, filename: string): LabMeta {
  const metaMatch = raw.match(/<!--\s*lab:meta([\s\S]*?)-->/);
  const defaults: LabMeta = {
    title: 'Untitled experiment',
    type: 'experiment',
    date: '',
    description: '',
    author: '',
    filename,
    href: `/lab/${filename}`,
  };
  if (!metaMatch) return defaults;
  const block = metaMatch[1];
  const get = (key: string) => {
    const m = block.match(new RegExp(`${key}:\\s*(.+)`));
    return m ? m[1].trim() : '';
  };
  return {
    title:       get('title')       || defaults.title,
    type:        get('type')        || defaults.type,
    date:        get('date')        || defaults.date,
    description: get('description') || defaults.description,
    author:      get('author')      || defaults.author,
    filename,
    href: `/lab/${filename}`,
  };
}

// Build card data from all discovered files
const experiments: LabMeta[] = Object.entries(labGlob)
  .map(([filePath, raw]) => {
    const filename = filePath.split('/').pop() ?? '';
    return parseMeta(raw, filename);
  })
  .sort((a, b) => {
    if (a.date && b.date) return b.date.localeCompare(a.date);
    return b.filename.localeCompare(a.filename);
  });

const isEmpty = experiments.length === 0;
---

<Base title="Lab" currentPath="/lab">

  <header class="page-header">
    <p class="eyebrow">Creative sandbox</p>
    <h1>Lab</h1>
    <p class="lead">
      Every experiment built from Brandforge — landing pages, one-sheets,
      email templates, ad creative. Each one reads from the same token barrel.
      Change a token upstream, every page here reflects it.
    </p>
  </header>

  {isEmpty ? (
    <div class="empty-state">
      <p class="empty-icon">◈</p>
      <p class="empty-title">No experiments yet</p>
      <p class="empty-body">
        Drop a <code>.html</code> file into <code>showcase/public/lab/</code> with a
        <code>&lt;!-- lab:meta --&gt;</code> comment block. It will appear here automatically on the next build.
      </p>
      <pre class="empty-code">{`<!-- lab:meta
title: Your page title
type: landing
date: 2026-05-28
description: What this is for
author: Your name
-->`}</pre>
    </div>
  ) : (
    <div class="lab-grid">
      {experiments.map(exp => (
        <a href={exp.href} class="lab-card" target="_blank" rel="noopener">
          <div class="lab-card-header">
            <span class="lab-type-badge" data-type={exp.type}>
              {TYPE_LABELS[exp.type] ?? exp.type}
            </span>
            {exp.date && <span class="lab-date">{exp.date}</span>}
          </div>
          <p class="lab-title">{exp.title}</p>
          {exp.description && <p class="lab-desc">{exp.description}</p>}
          {exp.author && <p class="lab-author">{exp.author}</p>}
          <span class="lab-open-link">
            Open →
          </span>
        </a>
      ))}
    </div>
  )}

</Base>

<style>
  .lab-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: var(--space-5);
    margin-top: var(--space-6);
  }

  .lab-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-5) var(--space-5) var(--space-4);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-md);
    background: var(--bg-canvas);
    color: inherit;
    text-decoration: none;
    transition: border-color 150ms, box-shadow 150ms;
    cursor: pointer;
  }
  .lab-card:hover {
    border-color: var(--color-aqua);
    box-shadow: 0 2px 12px rgba(50, 203, 237, 0.12);
    text-decoration: none;
  }

  .lab-card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    margin-bottom: var(--space-1);
  }

  .lab-type-badge {
    font-size: var(--fs-12);
    font-weight: var(--fw-semibold);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 2px 8px;
    border-radius: 20px;
    border: 1px solid transparent;
    /* default (experiment) */
    background: rgba(136, 135, 128, 0.13);
    color: var(--fg-3);
    border-color: rgba(136, 135, 128, 0.27);
  }
  .lab-type-badge[data-type="landing"] {
    background: rgba(50, 203, 237, 0.13);
    color: var(--color-aqua);
    border-color: rgba(50, 203, 237, 0.27);
  }
  .lab-type-badge[data-type="onesheet"] {
    background: rgba(9, 75, 119, 0.13);
    color: var(--color-navy);
    border-color: rgba(9, 75, 119, 0.27);
  }
  .lab-type-badge[data-type="email"] {
    background: rgba(93, 107, 152, 0.13);
    color: rgb(93, 107, 152);
    border-color: rgba(93, 107, 152, 0.27);
  }
  .lab-type-badge[data-type="ad"] {
    background: rgba(124, 92, 191, 0.13);
    color: rgb(124, 92, 191);
    border-color: rgba(124, 92, 191, 0.27);
  }
  .lab-type-badge[data-type="deck"] {
    background: rgba(26, 109, 128, 0.13);
    color: rgb(26, 109, 128);
    border-color: rgba(26, 109, 128, 0.27);
  }

  .lab-date {
    font-size: var(--fs-12);
    color: var(--fg-3);
    white-space: nowrap;
  }

  .lab-title {
    font-size: var(--fs-16);
    font-weight: var(--fw-semibold);
    color: var(--fg-1);
    line-height: var(--lh-snug);
    margin: 0;
  }

  .lab-desc {
    font-size: var(--fs-13);
    color: var(--fg-2);
    line-height: var(--lh-relaxed);
    margin: 0;
    flex: 1;
  }

  .lab-author {
    font-size: var(--fs-12);
    color: var(--fg-3);
    margin: 0;
  }

  .lab-open-link {
    font-size: var(--fs-13);
    color: var(--fg-accent);
    font-weight: var(--fw-medium);
    margin-top: var(--space-1);
  }

  /* Empty state */
  .empty-state {
    margin-top: var(--space-10);
    padding: var(--space-10) var(--space-8);
    border: 1px dashed var(--border-default);
    border-radius: var(--radius-md);
    text-align: center;
    color: var(--fg-3);
  }
  .empty-icon {
    font-size: 32px;
    margin-bottom: var(--space-3);
  }
  .empty-title {
    font-size: var(--fs-18);
    font-weight: var(--fw-semibold);
    color: var(--fg-2);
    margin-bottom: var(--space-2);
  }
  .empty-body {
    font-size: var(--fs-14);
    line-height: var(--lh-relaxed);
    max-width: 480px;
    margin: 0 auto var(--space-5);
  }
  .empty-code {
    display: inline-block;
    text-align: left;
    font-family: var(--font-mono);
    font-size: var(--fs-13);
    background: var(--bg-subtle);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-sm);
    padding: var(--space-4) var(--space-5);
    color: var(--fg-2);
    white-space: pre;
  }
</style>
