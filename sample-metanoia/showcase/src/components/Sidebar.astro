---
const VERSION = 'v3.7.0';

// SVG inner paths only — rendered inside a 14×14 / 0 0 24 24 SVG wrapper
const I = {
  home:      '<path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/>',
  history:   '<path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/><path d="M12 7v5l4 2"/>',
  droplet:   '<path d="M12 22a7 7 0 0 0 7-7c0-2-1-3.9-3-5.5s-3.5-4-4-6.5c-.5 2.5-2 4.9-4 6.5C6 11.1 5 13 5 15a7 7 0 0 0 7 7z"/>',
  type:      '<polyline points="4 7 4 4 20 4 20 7"/><line x1="9" x2="15" y1="20" y2="20"/><line x1="12" x2="12" y1="4" y2="20"/>',
  maximize2: '<polyline points="15 3 21 3 21 9"/><polyline points="9 21 3 21 3 15"/><line x1="21" x2="14" y1="3" y2="10"/><line x1="3" x2="10" y1="21" y2="14"/>',
  zap:       '<path d="M13 2 3 14h9l-1 8 10-12h-9l1-8z"/>',
  image:     '<rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/>',
  plug:      '<path d="M12 22v-5"/><path d="M9 8V2"/><path d="M15 8V2"/><rect x="4" y="8" width="16" height="7" rx="2"/>',
  pointer:   '<path d="M3 3l7.07 16.97 2.51-7.39 7.39-2.51L3 3z"/><path d="m13 13 6 6"/>',
  shapes:    '<path d="M8.3 10a.7.7 0 0 1-.626-1.079L11.4 3a.7.7 0 0 1 1.198-.043L16.3 8.9a.7.7 0 0 1-.572 1.1Z"/><rect x="3" y="14" width="7" height="7" rx="1"/><circle cx="17.5" cy="17.5" r="3.5"/>',
  penLine:   '<path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"/>',
  tag:       '<path d="M12.586 2.586A2 2 0 0 0 11.172 2H4a2 2 0 0 0-2 2v7.172a2 2 0 0 0 .586 1.414l8.704 8.704a2.426 2.426 0 0 0 3.42 0l6.58-6.58a2.426 2.426 0 0 0 0-3.42z"/><circle cx="7.5" cy="7.5" r="1" fill="currentColor" stroke="none"/>',
  creditCard:'<rect width="20" height="14" x="2" y="5" rx="2"/><line x1="2" x2="22" y1="10" y2="10"/>',
  layers:    '<path d="m12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83Z"/><path d="m22 17.65-9.17 4.16a2 2 0 0 1-1.66 0L2 17.65"/><path d="m22 12.65-9.17 4.16a2 2 0 0 1-1.66 0L2 12.65"/>',
  layout:    '<rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><line x1="3" x2="21" y1="9" y2="9"/><line x1="9" x2="9" y1="21" y2="9"/>',
  grid:      '<rect width="7" height="7" x="3" y="3" rx="1"/><rect width="7" height="7" x="14" y="3" rx="1"/><rect width="7" height="7" x="14" y="14" rx="1"/><rect width="7" height="7" x="3" y="14" rx="1"/>',
  wand2:     '<path d="m21.64 3.64-1.28-1.28a1.21 1.21 0 0 0-1.72 0L2.36 18.64a1.21 1.21 0 0 0 0 1.72l1.28 1.28a1.2 1.2 0 0 0 1.72 0L21.64 5.36a1.2 1.2 0 0 0 0-1.72"/><path d="m14 7 3 3"/><path d="M5 6v4M19 14v4M10 2v2M7 8H3M21 16h-4M11 3H9"/>',
  pencil:    '<path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/><path d="m15 5 4 4"/>',
  flask:     '<path d="M14 2v6l3.36 7.15a2 2 0 0 1-1.82 2.85H8.46a2 2 0 0 1-1.82-2.85L10 8V2"/><path d="M8.5 2h7"/><path d="M7 16h10"/>',
};

const NAV = [
  {
    label: 'Get started',
    items: [
      { href: '/',           label: 'Welcome',    icon: I.home },
      { href: '/changelog',  label: 'Changelog',  icon: I.history },
    ],
  },
  {
    label: 'Tokens',
    items: [
      { href: '/foundations/colors',     label: 'Colors',      icon: I.droplet },
      { href: '/foundations/typography', label: 'Typography',  icon: I.type },
      { href: '/foundations/spacing',    label: 'Spacing',     icon: I.maximize2 },
      { href: '/foundations/motion',     label: 'Motion',      icon: I.zap },
      { href: '/foundations/assets',     label: 'Assets',      icon: I.image },
      { href: '/foundations/adapters',   label: 'Adapters',    icon: I.plug },
    ],
  },
  {
    label: 'Atoms',
    items: [
      { href: '/components/buttons', label: 'Buttons',  icon: I.pointer },
      { href: '/components/icons',   label: 'Icons',    icon: I.shapes },
      { href: '/components/forms',   label: 'Forms',    icon: I.penLine },
      { href: '/components/labels',  label: 'Labels',   icon: I.tag },
      { href: '/components/cards',   label: 'Cards',    icon: I.creditCard },
    ],
  },
  {
    label: 'Molecules',
    items: [
      { href: '/components/molecules',  label: 'Molecules',  icon: I.layers },
      { href: '/components/organisms',  label: 'Organisms',  icon: I.layout },
    ],
  },
  {
    label: 'Templates',
    items: [
      { href: '/templates/', label: 'All templates', icon: I.grid },
    ],
  },
  {
    label: 'AI guide',
    items: [
      { href: '/ai-guide/generate', label: 'Generate on-brand', icon: I.wand2 },
      { href: '/ai-guide/update',   label: 'Update an asset',   icon: I.pencil },
    ],
  },
  {
    label: 'Lab',
    items: [
      { href: '/lab', label: 'All experiments', icon: I.flask },
    ],
  },
];

const { currentPath = '' } = Astro.props;
---

<nav class="sidebar" id="sidebar" aria-label="Site navigation">
  <div class="sidebar-header">
    <span class="sidebar-logo">Metanoia</span>
    <span class="sidebar-tagline">Brandforge</span>
    <button class="sidebar-close" id="sidebar-close" aria-label="Close menu">✕</button>
  </div>

  {NAV.map(group => (
    <div class="nav-group">
      <p class="nav-group-label">{group.label}</p>
      <ul>
        {group.items.map(item => (
          <li>
            <a href={item.href} class:list={['nav-link', { active: currentPath === item.href }]}>
              {item.icon && (
                <svg class="nav-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={item.icon} />
              )}
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </div>
  ))}

  <div class="sidebar-footer">
    <p class="sidebar-attribution">Brandforge by Founding Creative</p>
    <div class="sidebar-footer-row">
      <button class="theme-toggle" id="theme-toggle" aria-label="Toggle dark mode">
        <svg class="theme-icon theme-icon-light" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/></svg>
        <svg class="theme-icon theme-icon-dark" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
      </button>
      <a href="/changelog" class:list={['version-badge', { active: currentPath === '/changelog' }]}>{VERSION}</a>
    </div>
  </div>
</nav>

<button class="hamburger" id="hamburger" aria-label="Open menu" aria-expanded="false" aria-controls="sidebar">
  <span></span><span></span><span></span>
</button>

<div class="sidebar-backdrop" id="sidebar-backdrop"></div>

<style>
  .sidebar {
    position: fixed;
    top: 0; left: 0;
    width: 220px;
    height: 100dvh;
    background: var(--bg-subtle);
    border-right: 1px solid var(--border-default);
    padding: var(--space-6) 0;
    overflow-y: auto;
    z-index: 100;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .sidebar-header {
    display: flex;
    flex-direction: column;
    padding: 0 var(--space-5) var(--space-5);
    border-bottom: 1px solid var(--border-default);
    margin-bottom: var(--space-3);
    position: relative;
  }

  .sidebar-logo {
    font-size: var(--fs-18);
    font-weight: var(--fw-bold);
    color: var(--fg-1);
    letter-spacing: var(--ls-tight);
  }

  .sidebar-tagline {
    font-size: var(--fs-12);
    color: var(--fg-3);
  }

  .sidebar-close {
    display: none;
    position: absolute;
    top: 0;
    right: 0;
    background: none;
    border: none;
    cursor: pointer;
    color: var(--fg-3);
    font-size: var(--fs-16);
    padding: var(--space-1);
    line-height: 1;
  }

  .nav-group {
    padding: 0 var(--space-3);
  }

  .nav-group-label {
    margin: 0 0 var(--space-1);
    padding: var(--space-1) var(--space-2);
    font-size: var(--fs-12);
    font-weight: var(--fw-semibold);
    text-transform: uppercase;
    letter-spacing: var(--ls-wide);
    color: var(--fg-3);
  }

  ul { list-style: none; margin: 0; padding: 0; }

  .nav-link {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-sm);
    font-size: var(--fs-14);
    color: var(--fg-2);
    transition: background 120ms, color 120ms;
  }

  .nav-icon {
    flex-shrink: 0;
    opacity: 0.6;
    transition: opacity 120ms;
  }

  .nav-link:hover .nav-icon,
  .nav-link.active .nav-icon {
    opacity: 1;
  }
  .nav-link:hover {
    background: var(--bg-muted);
    color: var(--fg-1);
    text-decoration: none;
  }
  .nav-link.active {
    background: var(--bg-accent-soft);
    color: var(--fg-accent);
    font-weight: var(--fw-medium);
  }

  .hamburger {
    display: none;
    position: fixed;
    top: var(--space-4);
    left: var(--space-4);
    z-index: 200;
    background: var(--bg-canvas);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-sm);
    padding: var(--space-2) var(--space-3);
    cursor: pointer;
    flex-direction: column;
    gap: 4px;
  }
  .hamburger span {
    display: block;
    width: 18px;
    height: 2px;
    background: var(--fg-1);
    border-radius: 1px;
  }

  .sidebar-backdrop {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.3);
    z-index: 90;
  }

  @media (max-width: 768px) {
    .sidebar {
      transform: translateX(-100%);
      transition: transform 200ms ease;
      box-shadow: var(--shadow-lg);
    }
    .sidebar.open {
      transform: translateX(0);
    }
    .sidebar-close { display: block; }
    .hamburger { display: flex; }
    .sidebar-backdrop.open { display: block; }
  }

  .sidebar-footer {
    margin-top: auto;
    padding: var(--space-4) var(--space-5);
    border-top: 1px solid var(--border-default);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .sidebar-attribution {
    font-size: var(--fs-12);
    color: var(--fg-3);
    margin: 0;
    line-height: var(--lh-snug);
  }

  .sidebar-footer-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .theme-toggle {
    background: none;
    border: 1px solid var(--border-default);
    border-radius: var(--radius-sm);
    padding: var(--space-1) var(--space-3);
    cursor: pointer;
    color: var(--fg-3);
    font-size: var(--fs-14);
    display: flex;
    align-items: center;
    gap: var(--space-1);
    transition: background 120ms, color 120ms;
    line-height: 1;
  }
  .theme-toggle:hover { background: var(--bg-muted); color: var(--fg-1); }

  .theme-icon { display: none; }
  .theme-toggle[data-showing="dark"] .theme-icon-dark { display: block; }
  .theme-toggle[data-showing="light"] .theme-icon-light { display: block; }

  .version-badge {
    font-size: var(--fs-12);
    font-weight: var(--fw-semibold);
    color: var(--fg-3);
    background: var(--bg-muted);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-pill);
    padding: 2px var(--space-3);
    text-decoration: none;
    transition: background 120ms, color 120ms;
  }
  .version-badge:hover, .version-badge.active {
    background: var(--bg-accent-soft);
    color: var(--fg-accent);
    border-color: var(--border-accent);
  }
</style>

<script>
  const sidebar   = document.getElementById('sidebar')!;
  const hamburger = document.getElementById('hamburger')!;
  const closeBtn  = document.getElementById('sidebar-close')!;
  const backdrop  = document.getElementById('sidebar-backdrop')!;

  function openNav() {
    sidebar.classList.add('open');
    backdrop.classList.add('open');
    hamburger.setAttribute('aria-expanded', 'true');
  }
  function closeNav() {
    sidebar.classList.remove('open');
    backdrop.classList.remove('open');
    hamburger.setAttribute('aria-expanded', 'false');
  }

  hamburger.addEventListener('click', openNav);
  closeBtn.addEventListener('click', closeNav);
  backdrop.addEventListener('click', closeNav);
  document.addEventListener('keydown', e => { if (e.key === 'Escape') closeNav(); });

  // Theme toggle
  const themeBtn = document.getElementById('theme-toggle')!;
  function getEffectiveTheme(): 'light' | 'dark' {
    const stored = localStorage.getItem('ds-theme');
    if (stored === 'dark' || stored === 'light') return stored as 'light' | 'dark';
    return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
  }
  function applyTheme(theme: 'light' | 'dark') {
    document.documentElement.setAttribute('data-theme', theme);
    // Use data-showing on the button itself to avoid Astro CSS scoping issues with html ancestor
    themeBtn.setAttribute('data-showing', theme === 'dark' ? 'light' : 'dark');
  }
  // Init icon on load
  applyTheme(getEffectiveTheme());
  themeBtn.addEventListener('click', () => {
    const current = getEffectiveTheme();
    const next = current === 'dark' ? 'light' : 'dark';
    localStorage.setItem('ds-theme', next);
    applyTheme(next);
  });
</script>
