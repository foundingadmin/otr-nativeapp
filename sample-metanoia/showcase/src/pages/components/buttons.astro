---
import Base from '../../layouts/Base.astro';
---

<Base title="Buttons" currentPath="/components/buttons">
  <header class="page-header">
    <p class="eyebrow">Components</p>
    <h1>Buttons</h1>
    <p class="lead">
      Three variants (primary, secondary, ghost) × three sizes × all interactive states.
      All token bindings live in <code>brand/tokens/output/web/color-semantic.css</code>.
      The CSS classes live in <code>showcase/styles/components.css</code>.
    </p>
  </header>

  <section class="demo-section">
    <h2>Variants</h2>
    <div class="demo-row">
      <button class="btn btn--primary">Primary</button>
      <button class="btn btn--secondary">Secondary</button>
      <button class="btn btn--ghost">Ghost</button>
    </div>
    <pre class="code-block">&lt;button class="btn btn--primary"&gt;Primary&lt;/button&gt;
&lt;button class="btn btn--secondary"&gt;Secondary&lt;/button&gt;
&lt;button class="btn btn--ghost"&gt;Ghost&lt;/button&gt;</pre>
  </section>

  <section class="demo-section">
    <h2>Sizes</h2>
    <div class="demo-row align-end">
      <button class="btn btn--primary btn--sm">Small</button>
      <button class="btn btn--primary">Medium (default)</button>
      <button class="btn btn--primary btn--lg">Large</button>
    </div>
    <pre class="code-block">&lt;button class="btn btn--primary btn--sm"&gt;Small&lt;/button&gt;
&lt;button class="btn btn--primary"&gt;Medium (default)&lt;/button&gt;
&lt;button class="btn btn--primary btn--lg"&gt;Large&lt;/button&gt;</pre>
  </section>

  <section class="demo-section">
    <h2>Disabled states</h2>
    <div class="demo-row">
      <button class="btn btn--primary" disabled>Primary</button>
      <button class="btn btn--secondary" disabled>Secondary</button>
      <button class="btn btn--ghost" disabled>Ghost</button>
    </div>
    <p class="demo-note">
      Use the native <code>disabled</code> attribute or <code>aria-disabled="true"</code>
      (plus <code>pointer-events: none</code>) for non-button elements.
    </p>
  </section>

  <section class="demo-section">
    <h2>With icons</h2>
    <div class="demo-row">
      <button class="btn btn--primary">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        Continue
      </button>
      <button class="btn btn--secondary">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/></svg>
        Download
      </button>
      <button class="btn btn--ghost btn--icon-md" aria-label="Settings">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"/><circle cx="12" cy="12" r="3"/></svg>
      </button>
    </div>
    <pre class="code-block">&lt;!-- Icon left of label --&gt;
&lt;button class="btn btn--primary"&gt;
  &lt;svg ...&gt;&lt;/svg&gt;
  Continue
&lt;/button&gt;

&lt;!-- Icon-only: use btn--icon-md and aria-label --&gt;
&lt;button class="btn btn--ghost btn--icon-md" aria-label="Settings"&gt;
  &lt;svg ...&gt;&lt;/svg&gt;
&lt;/button&gt;</pre>
  </section>

  <section class="demo-section">
    <h2>Token reference</h2>
    <div class="token-table">
      <div class="token-row header-row">
        <span>Token</span>
        <span>Role</span>
      </div>
      {[
        ['--btn-primary-bg',         'Primary background'],
        ['--btn-primary-bg-hover',   'Primary hover'],
        ['--btn-primary-text',       'Primary label'],
        ['--btn-secondary-bg',       'Secondary background'],
        ['--btn-secondary-border',   'Secondary border'],
        ['--btn-secondary-text',     'Secondary label'],
        ['--btn-ghost-text',         'Ghost label'],
        ['--btn-ghost-border',       'Ghost border'],
      ].map(([token, role]) => (
        <div class="token-row">
          <code>{token}</code>
          <span>{role}</span>
        </div>
      ))}
    </div>
  </section>
</Base>

