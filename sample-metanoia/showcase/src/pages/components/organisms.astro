---
import Base from '../../layouts/Base.astro';
---

<Base title="Organisms" currentPath="/components/organisms">
  <header class="page-header">
    <p class="eyebrow">Components</p>
    <h1>Organisms</h1>
    <p class="lead">
      Full-composition UI sections: navigation bars, hero blocks, data tables, modals, and
      empty states. Shown as contained preview blocks — wire up your own routing and state.
    </p>
  </header>

  <!-- ── Top Nav ───────────────────────────────────────────── -->
  <section class="demo-section">
    <h2>Top nav bar</h2>
    <p class="demo-note">
      Horizontal navigation bar with logo, links, and a CTA button. Collapses to a hamburger
      on mobile — the demo shows the desktop state only.
    </p>
    <div class="demo-surface demo-surface--flush">
      <header class="topnav">
        <a href="#" class="topnav-logo" aria-label="metanoia home">
          <svg class="logo-mark" width="31" height="20" viewBox="0 0 206.995 135.041" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M163.452,2.621l-52.268,52.268,32.567,32.567.171.171,13.456-13.456v60.871h49.617V11.216c0-6.194-5.022-11.216-11.216-11.216h-25.998c-2.374,0-4.65.943-6.329,2.621Z" fill="var(--logo-accent)"/>
            <path d="M103.497,62.576L43.543,2.621c-1.679-1.679-3.955-2.621-6.329-2.621H11.216C5.022,0,0,5.022,0,11.216v123.825h49.617v-60.871l53.709,53.709.171-.171,32.567-32.567-32.567-32.567Z" fill="var(--logo-mark)"/>
          </svg>
          <span class="topnav-wordmark">metanoia</span>
        </a>
        <nav class="topnav-links" aria-label="Primary">
          <a href="#" class="topnav-link topnav-link--active" aria-current="page">Design</a>
          <a href="#" class="topnav-link">Tokens</a>
          <a href="#" class="topnav-link">Components</a>
          <a href="#" class="topnav-link">Templates</a>
        </nav>
        <div class="topnav-actions">
          <button type="button" class="btn btn--primary btn--sm">Get started</button>
        </div>
      </header>
    </div>
    <pre class="code-block">&lt;header class="topnav"&gt;
  &lt;a href="/" class="topnav-logo" aria-label="Home"&gt;
    &lt;svg class="logo-mark" width="31" height="20" viewBox="0 0 206.995 135.041"&gt;
      &lt;!-- right arm: fill="var(--logo-accent)" --&gt;
      &lt;!-- left arm:  fill="var(--logo-mark)" --&gt;
    &lt;/svg&gt;
    &lt;span class="topnav-wordmark"&gt;metanoia&lt;/span&gt;
  &lt;/a&gt;
  &lt;nav class="topnav-links" aria-label="Primary"&gt;
    &lt;a href="#" class="topnav-link topnav-link--active" aria-current="page"&gt;Design&lt;/a&gt;
    &lt;a href="#" class="topnav-link"&gt;Tokens&lt;/a&gt;
  &lt;/nav&gt;
  &lt;div class="topnav-actions"&gt;
    &lt;button type="button" class="btn btn--primary btn--sm"&gt;Get started&lt;/button&gt;
  &lt;/div&gt;
&lt;/header&gt;</pre>
  </section>

  <!-- ── Hero ─────────────────────────────────────────────── -->
  <section class="demo-section">
    <h2>Hero</h2>
    <p class="demo-note">
      Full-width page header with headline, subtext, and optional CTA pair. Use for landing
      pages and top-level section entry points. No decorative gradients or textures.
    </p>
    <div class="demo-surface demo-surface--flush">
      <div class="hero">
        <div class="hero-content">
          <p class="hero-eyebrow">Design system</p>
          <h2 class="hero-headline">Build with confidence, ship with consistency.</h2>
          <p class="hero-subtext">
            metanoia gives your team a shared visual language — from token primitives to
            fully composable components, ready for web, email, and slides.
          </p>
          <div class="hero-actions">
            <button type="button" class="btn btn--primary">Browse components</button>
            <button type="button" class="btn btn--secondary">View tokens</button>
          </div>
        </div>
      </div>
    </div>
    <pre class="code-block">&lt;div class="hero"&gt;
  &lt;div class="hero-content"&gt;
    &lt;p class="hero-eyebrow"&gt;Eyebrow label&lt;/p&gt;
    &lt;h1 class="hero-headline"&gt;Headline copy.&lt;/h1&gt;
    &lt;p class="hero-subtext"&gt;Supporting description.&lt;/p&gt;
    &lt;div class="hero-actions"&gt;
      &lt;button class="btn btn--primary"&gt;Primary CTA&lt;/button&gt;
      &lt;button class="btn btn--secondary"&gt;Secondary CTA&lt;/button&gt;
    &lt;/div&gt;
  &lt;/div&gt;
&lt;/div&gt;</pre>
  </section>

  <!-- ── Modal ────────────────────────────────────────────── -->
  <section class="demo-section">
    <h2>Modal</h2>
    <p class="demo-note">
      Focused dialog for confirmations and forms. Shown in open state below. Use
      <code>role="dialog"</code>, <code>aria-modal="true"</code>, and trap focus inside.
      Close on Escape and backdrop click.
    </p>
    <div class="demo-surface demo-surface--modal-host">
      <div class="modal-backdrop-preview">
        <div class="modal" role="dialog" aria-modal="true" aria-labelledby="modal-title-demo">
          <div class="modal-header">
            <h3 class="modal-title" id="modal-title-demo">Delete component</h3>
            <button type="button" class="modal-close" aria-label="Close dialog">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>
            </button>
          </div>
          <div class="modal-body">
            <p>This will permanently remove <strong>Button/Primary</strong> from the component library. This action cannot be undone.</p>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn--secondary">Cancel</button>
            <button type="button" class="btn btn--primary" style="background:var(--color-error-600);border-color:var(--color-error-600)">Delete</button>
          </div>
        </div>
      </div>
    </div>
    <pre class="code-block">&lt;div class="modal-backdrop" role="presentation"&gt;
  &lt;div class="modal" role="dialog" aria-modal="true" aria-labelledby="modal-title"&gt;
    &lt;div class="modal-header"&gt;
      &lt;h2 class="modal-title" id="modal-title"&gt;Dialog title&lt;/h2&gt;
      &lt;button type="button" class="modal-close" aria-label="Close dialog"&gt;
        &lt;svg ...&gt;&lt;/svg&gt;
      &lt;/button&gt;
    &lt;/div&gt;
    &lt;div class="modal-body"&gt;Content&lt;/div&gt;
    &lt;div class="modal-footer"&gt;
      &lt;button class="btn btn--secondary"&gt;Cancel&lt;/button&gt;
      &lt;button class="btn btn--primary"&gt;Confirm&lt;/button&gt;
    &lt;/div&gt;
  &lt;/div&gt;
&lt;/div&gt;</pre>
  </section>

  <!-- ── Data Table ────────────────────────────────────────── -->
  <section class="demo-section">
    <h2>Data table</h2>
    <p class="demo-note">
      Structured grid for token or component data. Always use <code>scope="col"</code> on
      header cells. Zebra striping uses <code>--bg-subtle</code> to stay token-correct.
    </p>
    <div class="demo-surface demo-surface--flush">
      <div class="table-wrap">
        <table class="data-table">
          <thead>
            <tr>
              <th scope="col">Client</th>
              <th scope="col">Project</th>
              <th scope="col">Status</th>
              <th scope="col">Value</th>
              <th scope="col">Owner</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><strong>Aether Studios</strong></td>
              <td>Brand refresh</td>
              <td><span class="badge badge--success badge--dot">Active</span></td>
              <td>$42,000</td>
              <td>Sarah K.</td>
            </tr>
            <tr>
              <td><strong>Helio Health</strong></td>
              <td>Campaign assets</td>
              <td><span class="badge badge--info badge--dot">In review</span></td>
              <td>$18,500</td>
              <td>Marcus T.</td>
            </tr>
            <tr>
              <td><strong>Vantage Group</strong></td>
              <td>Annual report</td>
              <td><span class="badge badge--dot">Complete</span></td>
              <td>$9,200</td>
              <td>Sarah K.</td>
            </tr>
            <tr>
              <td><strong>Forge Creative</strong></td>
              <td>UI kit build</td>
              <td><span class="badge badge--success badge--dot">Active</span></td>
              <td>$31,000</td>
              <td>Jordan L.</td>
            </tr>
            <tr>
              <td><strong>Luma Publishing</strong></td>
              <td>Guidelines doc</td>
              <td><span class="badge badge--warning badge--dot">On hold</span></td>
              <td>$5,800</td>
              <td>Marcus T.</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
    <pre class="code-block">&lt;div class="table-wrap"&gt;
  &lt;table class="data-table"&gt;
    &lt;thead&gt;
      &lt;tr&gt;
        &lt;th scope="col"&gt;Client&lt;/th&gt;
        &lt;th scope="col"&gt;Project&lt;/th&gt;
        &lt;th scope="col"&gt;Status&lt;/th&gt;
        &lt;th scope="col"&gt;Value&lt;/th&gt;
      &lt;/tr&gt;
    &lt;/thead&gt;
    &lt;tbody&gt;
      &lt;tr&gt;
        &lt;td&gt;...&lt;/td&gt;
        &lt;td&gt;...&lt;/td&gt;
      &lt;/tr&gt;
    &lt;/tbody&gt;
  &lt;/table&gt;
&lt;/div&gt;</pre>
  </section>

  <!-- ── Empty State ───────────────────────────────────────── -->
  <section class="demo-section">
    <h2>Empty state</h2>
    <p class="demo-note">
      Placeholder shown when a list, table, or section has no content. Use a Lucide icon
      (2px stroke, 40px) for the illustration slot. Keep copy actionable — tell the user
      what to do next.
    </p>
    <div class="demo-surface">
      <div class="empty-state">
        <div class="empty-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
        </div>
        <h3 class="empty-title">No components yet</h3>
        <p class="empty-body">Add a component to your library to get started. Your changes sync with Figma automatically.</p>
        <button type="button" class="btn btn--primary">Add component</button>
      </div>
    </div>
    <pre class="code-block">&lt;div class="empty-state"&gt;
  &lt;div class="empty-icon"&gt;
    &lt;svg ...&gt;&lt;/svg&gt;
  &lt;/div&gt;
  &lt;h3 class="empty-title"&gt;No items yet&lt;/h3&gt;
  &lt;p class="empty-body"&gt;Actionable description.&lt;/p&gt;
  &lt;button type="button" class="btn btn--primary"&gt;CTA&lt;/button&gt;
&lt;/div&gt;</pre>
  </section>
</Base>

<style>
  /* ── Top Nav ─────────────────────────────────────────────── */
  .demo-surface--flush {
    padding: 0;
    overflow: hidden;
  }

  .topnav {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    padding: var(--space-4) var(--space-6);
    background: var(--bg-canvas);
    border-bottom: 1px solid var(--border-default);
  }

  .topnav-logo {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    text-decoration: none;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .logo-mark {
    display: block;
    flex-shrink: 0;
  }

  .topnav-wordmark {
    font-family: var(--font-sans);
    font-size: var(--fs-16);
    font-weight: var(--fw-bold);
    color: var(--logo-wordmark);
    letter-spacing: var(--ls-tight);
  }

  .topnav-links {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    flex: 1;
  }

  .topnav-link {
    font-family: var(--font-sans);
    font-size: var(--fs-14);
    font-weight: var(--fw-medium);
    color: var(--fg-3);
    text-decoration: none;
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-sm);
    transition: background var(--dur-fast) var(--ease-standard),
                color var(--dur-fast) var(--ease-standard);
  }
  .topnav-link:hover { background: var(--bg-muted); color: var(--fg-1); }
  .topnav-link--active { color: var(--fg-1); font-weight: var(--fw-semibold); }

  .topnav-actions { margin-left: auto; }

  /* ── Hero ────────────────────────────────────────────────── */
  .hero {
    padding: var(--space-12) var(--space-8);
    background: var(--bg-subtle);
    border-top: 1px solid var(--border-subtle);
  }

  .hero-content {
    max-width: 640px;
  }

  .hero-eyebrow {
    font-family: var(--font-sans);
    font-size: var(--fs-13);
    font-weight: var(--fw-semibold);
    color: var(--fg-accent);
    text-transform: uppercase;
    letter-spacing: var(--ls-wide);
    margin: 0 0 var(--space-3);
  }

  .hero-headline {
    font-family: var(--font-sans);
    font-size: var(--fs-32);
    font-weight: var(--fw-bold);
    color: var(--fg-1);
    line-height: var(--lh-tight);
    letter-spacing: var(--ls-tight);
    margin: 0 0 var(--space-4);
  }

  .hero-subtext {
    font-family: var(--font-sans);
    font-size: var(--fs-16);
    color: var(--fg-2);
    line-height: var(--lh-relaxed);
    margin: 0 0 var(--space-8);
    max-width: 540px;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  /* ── Modal ───────────────────────────────────────────────── */
  .demo-surface--modal-host {
    min-height: 320px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--bg-muted);
  }

  .modal-backdrop-preview {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
  }

  .modal {
    background: var(--bg-canvas);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    width: 100%;
    max-width: 440px;
    overflow: hidden;
  }

  .modal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-5) var(--space-6) var(--space-4);
    border-bottom: 1px solid var(--border-subtle);
  }

  .modal-title {
    font-family: var(--font-sans);
    font-size: var(--fs-16);
    font-weight: var(--fw-semibold);
    color: var(--fg-1);
    margin: 0;
  }

  .modal-close {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    background: none;
    border: none;
    cursor: pointer;
    color: var(--fg-3);
    border-radius: var(--radius-sm);
    transition: background var(--dur-fast) var(--ease-standard),
                color var(--dur-fast) var(--ease-standard);
  }
  .modal-close:hover { background: var(--bg-muted); color: var(--fg-1); }
  .modal-close:focus-visible { outline: none; box-shadow: var(--shadow-focus); }

  .modal-body {
    padding: var(--space-5) var(--space-6);
    font-family: var(--font-sans);
    font-size: var(--fs-14);
    color: var(--fg-2);
    line-height: var(--lh-relaxed);
  }

  .modal-body p { margin: 0; }

  .modal-footer {
    display: flex;
    justify-content: flex-end;
    gap: var(--space-3);
    padding: var(--space-4) var(--space-6) var(--space-5);
    border-top: 1px solid var(--border-subtle);
    background: var(--bg-subtle);
  }

  /* ── Data Table ──────────────────────────────────────────── */
  .table-wrap {
    overflow-x: auto;
    width: 100%;
  }

  .data-table {
    width: 100%;
    border-collapse: collapse;
    font-family: var(--font-sans);
    font-size: var(--fs-14);
  }

  .data-table th {
    padding: var(--space-3) var(--space-4);
    text-align: left;
    font-weight: var(--fw-semibold);
    font-size: var(--fs-12);
    color: var(--fg-3);
    text-transform: uppercase;
    letter-spacing: var(--ls-wide);
    background: var(--bg-subtle);
    border-bottom: 1px solid var(--border-default);
    white-space: nowrap;
  }

  .data-table td {
    padding: var(--space-3) var(--space-4);
    color: var(--fg-2);
    border-bottom: 1px solid var(--border-subtle);
    vertical-align: middle;
  }

  .data-table tbody tr:nth-child(even) td {
    background: var(--bg-subtle);
  }

  .data-table tbody tr:last-child td {
    border-bottom: none;
  }

  .token-name {
    font-family: monospace;
    font-size: var(--fs-13);
    background: var(--bg-muted);
    border-radius: var(--radius-xs);
    padding: 1px var(--space-2);
    color: var(--fg-accent);
    white-space: nowrap;
  }

  .color-swatch {
    display: inline-block;
    width: 12px;
    height: 12px;
    border-radius: var(--radius-xs);
    border: 1px solid rgba(0,0,0,0.1);
    vertical-align: middle;
    margin-right: var(--space-2);
  }

  /* Badge reuse from labels page — minimal set for table */
  .badge {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-sans);
    font-size: var(--fs-12);
    font-weight: var(--fw-semibold);
    padding: 2px var(--space-2);
    border-radius: var(--radius-pill);
    white-space: nowrap;
    border: 1px solid transparent;
  }
  .badge--info {
    background: var(--color-info-200);
    color: var(--color-info-800);
    border-color: var(--color-info-400);
  }
  .badge--success {
    background: var(--color-success-200);
    color: var(--color-success-800);
    border-color: var(--color-success-400);
  }
  .badge--warning {
    background: var(--color-warning-200);
    color: var(--color-warning-800);
    border-color: var(--color-warning-400);
  }
  [data-theme="dark"] .badge--info {
    background: rgba(124,91,217,0.2);
    color: var(--color-info-400);
    border-color: rgba(124,91,217,0.3);
  }
  [data-theme="dark"] .badge--success {
    background: rgba(46,158,110,0.2);
    color: var(--color-success-400);
    border-color: rgba(46,158,110,0.3);
  }
  [data-theme="dark"] .badge--warning {
    background: rgba(233,162,59,0.2);
    color: var(--color-warning-400);
    border-color: rgba(233,162,59,0.3);
  }

  /* ── Empty State ─────────────────────────────────────────── */
  .empty-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: var(--space-12) var(--space-6);
    gap: var(--space-4);
    max-width: 400px;
    margin: 0 auto;
  }

  .empty-icon {
    color: var(--fg-4);
    line-height: 1;
  }

  .empty-title {
    font-family: var(--font-sans);
    font-size: var(--fs-16);
    font-weight: var(--fw-semibold);
    color: var(--fg-1);
    margin: 0;
  }

  .empty-body {
    font-family: var(--font-sans);
    font-size: var(--fs-14);
    color: var(--fg-3);
    line-height: var(--lh-relaxed);
    margin: 0;
  }
</style>
