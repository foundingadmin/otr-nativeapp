---
import Base from '../../layouts/Base.astro';
---

<Base title="Assets" currentPath="/foundations/assets">
  <header class="page-header">
    <p class="eyebrow">Foundations</p>
    <h1>Assets</h1>
    <p class="lead">
      Brand assets live in <code>brand/assets/</code>. All logos are SVG. Use the correct
      variant for the surface — never stretch, recolor, or add effects.
    </p>
  </header>

  <section class="token-section">
    <h2>Brandmark</h2>
    <div class="logo-pair">
      <div class="logo-card light-bg">
        <div class="logo-display">
          <svg xmlns="http://www.w3.org/2000/svg" width="80" height="52" viewBox="0 0 206.995 135.041" aria-label="Metanoia brandmark">
