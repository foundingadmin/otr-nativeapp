---
import Base from '../../layouts/Base.astro';

const TEMPLATES = [
  {
    name: 'Landing page',
    slug: 'landing-page',
    description: 'Single-page marketing site. Hero, features grid, testimonial, CTA.',
    format: 'HTML / Astro',
    ready: true,
    prompt: `Create a landing page using Brandforge.

Structure:
- Hero: headline, subhead, two CTAs (primary + ghost button)
- Features: 3-column grid, icon + title + one-sentence description per card
- Testimonial: blockquote, attribution, company logo placeholder
- Footer CTA: centered headline + primary button

Rules:
- Use CSS custom properties only — no hardcoded hex values or font sizes
- Token reference: brand/tokens/output/web/
- All spacing via --space-* tokens
- Typography via --fs-*, --fw-*, --lh-* tokens
- Colors via --bg-*, --fg-*, --border-* semantic tokens
- Buttons: .btn class using --btn-primary-* or --btn-secondary-* tokens
- No emoji, no exclamation marks, no decorative gradients`,
  },
  {
    name: 'Pitch deck',
    slug: 'pitch-deck',
    description: '10-slide presentation. Cover, problem, solution, market, team, ask.',
    format: 'PPTX',
    ready: false,
    gateNote: 'Requires metanoia-pptx repo — not yet built.',
    prompt: `Create a 10-slide pitch deck using the Metanoia pptx-json adapter.

Slides:
1. Cover — company name, tagline, presenter name
2. Problem — one headline, 3 bullet points
3. Solution — headline, 2-column: description + visual placeholder
4. Market — TAM/SAM/SOM circles (placeholder), key stat callout
5. Product — headline, 3 feature callouts with icons
6. Traction — 3 metric tiles (number + label)
7. Business model — simple revenue breakdown
8. Team — 3 headshots + name + role
9. Roadmap — 3-column timeline: Now / Next / Later
10. Ask — investment amount, use of funds, contact

Token format: Use flat dot-notation keys from brand/tokens/output/pptx/tokens.json
Typography: typography.size.*, typography.weight.*
Colors: color.navy, color.aqua, color.grey.*`,
  },
  {
    name: 'Email',
    slug: 'email',
    description: 'Transactional or marketing email. Pre-header, hero, body, CTA, footer.',
    format: 'Inline HTML',
    ready: false,
    gateNote: 'Requires email surface in metanoia-web — not yet built.',
    prompt: `Create an HTML email template using Metanoia brand values.

Structure:
- Pre-header text (hidden, 90 chars)
- Header: logo wordmark, nav links (2)
- Hero: background --color-navy, headline white, subhead, CTA button
- Body: 2 content sections (icon + heading + paragraph each)
- Divider
- Footer: address, unsubscribe link, social icons

Rules:
- Inline CSS only (email clients don't support external stylesheets)
- Use actual hex values from brand/tokens/output/web/color-primitives.css — no var() in email
- Font stack: "Figtree", "Helvetica Neue", Arial, sans-serif
- Max width: 600px, center-aligned
- All images have alt text
- CTA button uses table-based layout for Outlook compatibility`,
  },
  {
    name: 'One-sheet',
    slug: 'one-sheet',
    description: 'Single A4/Letter page. Product overview, benefits, contact.',
    format: 'PPTX',
    ready: false,
    gateNote: 'Requires metanoia-pptx repo — not yet built.',
    prompt: `Create a one-sheet (A4 portrait) using the Metanoia pptx-json adapter.

Structure:
- Header strip: navy background, logo left, tagline right
- Hero block: large headline (--fs-36), subhead (--fs-18), 2-line descriptor
- Benefits: 3 rows, each with icon placeholder + bold label + one sentence
- Social proof: 2 client logos (placeholder) + one pull quote
- Footer strip: navy, website URL, email, phone

Rules:
- Token values from brand/tokens/output/pptx/tokens.json
- Page dimensions: 210mm × 297mm with 16mm margins
- Print-safe: no box-shadows, use border instead
- Font: "Figtree" with @font-face pointing to brand/fonts/
- All colors via semantic tokens — no hardcoded hex

Note: One-sheets are offline outputs. Re-generate from the DS to pick up brand updates.`,
  },
];
---

<Base title="Templates" currentPath="/templates/">
  <header class="page-header">
    <p class="eyebrow">Templates</p>
    <h1>Ready-to-use templates.</h1>
    <p class="lead">
      Each template is a copy-ready AI prompt. Paste it into Claude Code (or any model) with the
      Brandforge is already connected. The output will use your brand tokens from first draft.
    </p>
  </header>

  <div class="templates-grid">
    {TEMPLATES.map(t => (
      <article class={`template-card${t.ready ? '' : ' template-card--gated'}`}>
        <div class="card-thumbnail" aria-hidden="true">
          <span class="thumbnail-label">{t.name}</span>
        </div>
        <div class="card-body">
          <div class="card-meta">
            <h2>{t.name}</h2>
            <span class="format-badge">{t.format}</span>
            {t.ready && <span class="ready-badge">Ready</span>}
          </div>
          <p class="card-desc">{t.description}</p>
          {!t.ready && t.gateNote && (
            <p class="gate-note">{t.gateNote}</p>
          )}
          <div class={`card-prompt${t.ready ? '' : ' card-prompt--dimmed'}`} id={`prompt-${t.slug}`}>
            <pre><code>{t.prompt}</code></pre>
          </div>
          {t.ready ? (
            <button
              class="copy-btn"
              data-target={`prompt-${t.slug}`}
              aria-label={`Copy AI prompt for ${t.name}`}
            >
              Copy AI prompt
            </button>
          ) : (
            <button class="copy-btn copy-btn--disabled" disabled aria-disabled="true">
              Coming soon
            </button>
          )}
        </div>
      </article>
    ))}
  </div>
</Base>

<style>
  .page-header {
    padding-bottom: var(--space-8);
    border-bottom: 1px solid var(--border-subtle);
    margin-bottom: var(--space-10);
  }

  .eyebrow {
    font-size: var(--fs-12);
    font-weight: var(--fw-semibold);
    text-transform: uppercase;
    letter-spacing: var(--ls-wide);
    color: var(--fg-accent);
    margin: 0 0 var(--space-3);
  }

  h1 {
    font-size: var(--fs-36);
    font-weight: var(--fw-bold);
    letter-spacing: var(--ls-tight);
    line-height: var(--lh-tight);
    margin: 0 0 var(--space-4);
    color: var(--fg-1);
  }

  .lead {
    font-size: var(--fs-18);
    color: var(--fg-2);
    line-height: var(--lh-relaxed);
    max-width: 580px;
    margin: 0;
  }

  .templates-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-6);
  }

  .template-card {
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .template-card--gated {
    opacity: 0.85;
  }

  .card-thumbnail {
    height: 140px;
    background: var(--bg-subtle);
    border-bottom: 1px solid var(--border-subtle);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .thumbnail-label {
    font-size: var(--fs-12);
    font-weight: var(--fw-semibold);
    color: var(--fg-3);
    letter-spacing: var(--ls-wide);
    text-transform: uppercase;
  }

  .card-body {
    padding: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    flex: 1;
  }

  .card-meta {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .card-meta h2 {
    font-size: var(--fs-18);
    font-weight: var(--fw-bold);
    margin: 0;
    color: var(--fg-1);
  }

  .format-badge {
    font-size: var(--fs-12);
    font-weight: var(--fw-medium);
    color: var(--fg-accent);
    background: var(--bg-accent-soft);
    padding: 2px var(--space-2);
    border-radius: var(--radius-xs);
  }

  .ready-badge {
    font-size: var(--fs-12);
    font-weight: var(--fw-semibold);
    color: var(--color-aqua, #32cbed);
    background: color-mix(in srgb, var(--color-aqua, #32cbed) 12%, transparent);
    padding: 2px var(--space-2);
    border-radius: var(--radius-xs);
  }

  .card-desc {
    font-size: var(--fs-14);
    color: var(--fg-2);
    line-height: var(--lh-relaxed);
    margin: 0;
  }

  .gate-note {
    font-size: var(--fs-13);
    color: var(--fg-3);
    line-height: var(--lh-relaxed);
    margin: 0;
  }

  .card-prompt {
    background: var(--bg-subtle);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    max-height: 200px;
    overflow-y: auto;
  }

  .card-prompt--dimmed {
    opacity: 0.4;
  }

  .card-prompt pre {
    margin: 0;
    border: none;
    background: transparent;
    font-size: var(--fs-12);
    line-height: var(--lh-relaxed);
    padding: var(--space-4);
  }

  .copy-btn {
    align-self: flex-start;
    padding: var(--space-2) var(--space-5);
    background: var(--btn-primary-bg);
    color: var(--btn-primary-text);
    border: none;
    border-radius: var(--radius-sm);
    font-family: var(--font-sans);
    font-size: var(--fs-14);
    font-weight: var(--fw-medium);
    cursor: pointer;
    transition: background 120ms;
  }
  .copy-btn:hover { background: var(--btn-primary-bg-hover); }
  .copy-btn.copied { background: var(--border-accent); }

  .copy-btn--disabled {
    background: var(--bg-muted);
    color: var(--fg-3);
    cursor: default;
    pointer-events: none;
  }
  .copy-btn--disabled:hover { background: var(--bg-muted); }

  @media (max-width: 720px) {
    .templates-grid { grid-template-columns: 1fr; }
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('.copy-btn:not(.copy-btn--disabled)').forEach(btn => {
    btn.addEventListener('click', async () => {
      const targetId = btn.dataset.target!;
      const pre = document.getElementById(targetId)?.querySelector('code');
      const text = pre?.textContent ?? '';
      try {
        await navigator.clipboard.writeText(text);
      } catch {
        const ta = document.createElement('textarea');
        ta.value = text;
        document.body.appendChild(ta);
        ta.select();
        document.execCommand('copy');
        document.body.removeChild(ta);
      }
      const original = btn.textContent;
      btn.textContent = 'Copied';
      btn.classList.add('copied');
      setTimeout(() => {
        btn.textContent = original;
        btn.classList.remove('copied');
      }, 1500);
    });
  });
</script>
