{
  "$description": "Metanoia — Motion Tokens. Easing curves and duration tiers. 120–200–320ms; no bounces or spring overshoots.",

  "ease-standard":  { "$value": "cubic-bezier(0.2, 0, 0, 1)",   "$type": "cubicBezier" },
  "ease-emphasized": { "$value": "cubic-bezier(0.2, 0, 0, 1.2)", "$type": "cubicBezier" },
  "ease-out":       { "$value": "cubic-bezier(0, 0, 0, 1)",      "$type": "cubicBezier" },

  "dur-fast": { "$value": "120ms", "$type": "duration" },
  "dur-base": { "$value": "200ms", "$type": "duration" },
  "dur-slow": { "$value": "320ms", "$type": "duration" }
}
