{
  "$description": "Metanoia — Color Semantic Aliases. Role-based tokens referencing color-primitives. Always use these in components. Dark mode values in $extensions.com.metanoia.modes.dark.",

  "bg-canvas":      { "$value": "{color-white}",    "$type": "color", "$extensions": { "com.metanoia.modes": { "dark": "{color-grey-900}" } } },
  "bg-subtle":      { "$value": "{color-grey-50}",  "$type": "color", "$extensions": { "com.metanoia.modes": { "dark": "{color-navy-900}" } } },
  "bg-muted":       { "$value": "{color-grey-100}", "$type": "color", "$extensions": { "com.metanoia.modes": { "dark": "{color-navy-700}" } } },
  "bg-accent-soft": { "$value": "{color-aqua-50}",  "$type": "color", "$extensions": { "com.metanoia.modes": { "dark": "rgba(50,203,237,0.12)" } } },
  "bg-accent":      { "$value": "{color-aqua}",     "$type": "color", "$extensions": { "com.metanoia.modes": { "dark": "{color-aqua}" } } },

  "fg-1":          { "$value": "{color-navy-900}",  "$type": "color", "$extensions": { "com.metanoia.modes": { "dark": "{color-white}" } } },
  "fg-2":          { "$value": "{color-grey-800}",  "$type": "color", "$extensions": { "com.metanoia.modes": { "dark": "rgba(255,255,255,0.88)" } } },
  "fg-3":          { "$value": "{color-grey-600}",  "$type": "color", "$extensions": { "com.metanoia.modes": { "dark": "rgba(255,255,255,0.72)" } } },
  "fg-4":          { "$value": "{color-grey-400}",  "$type": "color", "$extensions": { "com.metanoia.modes": { "dark": "rgba(255,255,255,0.48)" } } },
  "fg-link":       { "$value": "{color-navy}",      "$type": "color", "$extensions": { "com.metanoia.modes": { "dark": "{color-light-aqua}" } } },
  "fg-link-hover": { "$value": "{color-aqua-700}",  "$type": "color", "$extensions": { "com.metanoia.modes": { "dark": "{color-aqua}" } } },
  "fg-accent":     { "$value": "{color-aqua-700}",  "$type": "color", "$extensions": { "com.metanoia.modes": { "dark": "{color-aqua-300}" } } },

  "border-subtle":  { "$value": "{color-grey-200}", "$type": "color", "$extensions": { "com.metanoia.modes": { "dark": "rgba(255,255,255,0.1)" } } },
  "border-default": { "$value": "{color-grey-300}", "$type": "color", "$extensions": { "com.metanoia.modes": { "dark": "{color-grey-700}" } } },
  "border-strong":  { "$value": "{color-grey-600}", "$type": "color", "$extensions": { "com.metanoia.modes": { "dark": "{color-grey-400}" } } },
  "border-accent":  { "$value": "{color-aqua}",     "$type": "color", "$extensions": { "com.metanoia.modes": { "dark": "{color-aqua}" } } },

  "logo-accent":   { "$value": "{color-aqua}",     "$type": "color", "$extensions": { "com.metanoia.modes": { "dark": "{color-aqua}" } } },
  "logo-mark":     { "$value": "{color-navy-700}", "$type": "color", "$extensions": { "com.metanoia.modes": { "dark": "{color-white}" } } },
  "logo-wordmark": { "$value": "{color-navy-700}", "$type": "color", "$extensions": { "com.metanoia.modes": { "dark": "{color-white}" } } },

  "btn-primary-bg":            { "$value": "{color-navy-700}", "$type": "color", "$extensions": { "com.metanoia.modes": { "dark": "{color-navy-500}" } } },
  "btn-primary-bg-hover":      { "$value": "{color-navy-500}", "$type": "color", "$extensions": { "com.metanoia.modes": { "dark": "{color-aqua-700}" } } },
  "btn-primary-bg-active":     { "$value": "{color-navy-900}", "$type": "color", "$extensions": { "com.metanoia.modes": { "dark": "{color-navy-700}" } } },
  "btn-primary-bg-disabled":   { "$value": "{color-grey-50}",  "$type": "color", "$extensions": { "com.metanoia.modes": { "dark": "{color-navy-900}" } } },
  "btn-primary-text":          { "$value": "{color-white}",    "$type": "color", "$extensions": { "com.metanoia.modes": { "dark": "{color-white}" } } },
  "btn-primary-text-disabled": { "$value": "{color-grey-400}", "$type": "color", "$extensions": { "com.metanoia.modes": { "dark": "#42677F" } } },

  "btn-secondary-bg":              { "$value": "{color-white}",    "$type": "color", "$extensions": { "com.metanoia.modes": { "dark": "{color-grey-800}" } } },
  "btn-secondary-bg-hover":        { "$value": "{color-navy-100}", "$type": "color", "$extensions": { "com.metanoia.modes": { "dark": "{color-navy-900}" } } },
  "btn-secondary-bg-active":       { "$value": "{color-navy-100}", "$type": "color", "$extensions": { "com.metanoia.modes": { "dark": "{color-navy-700}" } } },
  "btn-secondary-bg-disabled":     { "$value": "{color-white}",    "$type": "color", "$extensions": { "com.metanoia.modes": { "dark": "{color-grey-800}" } } },
  "btn-secondary-text":            { "$value": "{color-navy-900}", "$type": "color", "$extensions": { "com.metanoia.modes": { "dark": "{color-white}" } } },
  "btn-secondary-text-disabled":   { "$value": "{color-grey-400}", "$type": "color", "$extensions": { "com.metanoia.modes": { "dark": "#3D6986" } } },
  "btn-secondary-border":          { "$value": "{color-navy-700}", "$type": "color", "$extensions": { "com.metanoia.modes": { "dark": "{color-navy-500}" } } },
  "btn-secondary-border-hover":    { "$value": "{color-navy-900}", "$type": "color", "$extensions": { "com.metanoia.modes": { "dark": "{color-aqua-700}" } } },
  "btn-secondary-border-active":   { "$value": "{color-navy-900}", "$type": "color", "$extensions": { "com.metanoia.modes": { "dark": "{color-aqua-500}" } } },
  "btn-secondary-border-disabled": { "$value": "{color-grey-200}", "$type": "color", "$extensions": { "com.metanoia.modes": { "dark": "{color-navy-700}" } } },

  "btn-ghost-bg-hover":        { "$value": "{color-grey-100}", "$type": "color", "$extensions": { "com.metanoia.modes": { "dark": "{color-navy-900}" } } },
  "btn-ghost-bg-active":       { "$value": "{color-grey-200}", "$type": "color", "$extensions": { "com.metanoia.modes": { "dark": "{color-navy-900}" } } },
  "btn-ghost-text":            { "$value": "{color-navy-700}", "$type": "color", "$extensions": { "com.metanoia.modes": { "dark": "{color-white}" } } },
  "btn-ghost-text-disabled":   { "$value": "{color-grey-400}", "$type": "color", "$extensions": { "com.metanoia.modes": { "dark": "#3D6986" } } },
  "btn-ghost-border":          { "$value": "{color-grey-300}", "$type": "color", "$extensions": { "com.metanoia.modes": { "dark": "{color-navy-700}" } } },
  "btn-ghost-border-disabled": { "$value": "{color-grey-200}", "$type": "color", "$extensions": { "com.metanoia.modes": { "dark": "{color-navy-700}" } } }
}
