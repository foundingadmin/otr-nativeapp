{
  "$description": "Metanoia — Typography Tokens. Families, weights, size scale, line-heights, letter-spacing.",

  "font-sans":  { "$value": ["Figtree", "ui-sans-serif", "system-ui", "-apple-system", "Segoe UI", "Roboto", "Helvetica Neue", "Arial", "sans-serif"], "$type": "fontFamily" },
  "font-mono":  { "$value": ["JetBrains Mono", "ui-monospace", "SFMono-Regular", "Menlo", "Consolas", "monospace"], "$type": "fontFamily" },
  "font-brand": { "$value": "{font-sans}", "$type": "fontFamily" },

  "fw-light":    { "$value": 300, "$type": "fontWeight" },
  "fw-regular":  { "$value": 400, "$type": "fontWeight" },
  "fw-medium":   { "$value": 500, "$type": "fontWeight" },
  "fw-semibold": { "$value": 600, "$type": "fontWeight" },
  "fw-bold":     { "$value": 700, "$type": "fontWeight" },

  "fs-12":  { "$value": "0.75rem",   "$type": "dimension", "$description": "12 — micro" },
  "fs-13":  { "$value": "0.8125rem", "$type": "dimension", "$description": "13 — caption" },
  "fs-14":  { "$value": "0.875rem",  "$type": "dimension", "$description": "14 — small" },
  "fs-15":  { "$value": "0.9375rem", "$type": "dimension" },
  "fs-16":  { "$value": "1rem",      "$type": "dimension", "$description": "16 — body" },
  "fs-18":  { "$value": "1.125rem",  "$type": "dimension", "$description": "18 — body large / subheading" },
  "fs-20":  { "$value": "1.25rem",   "$type": "dimension" },
  "fs-22":  { "$value": "1.375rem",  "$type": "dimension" },
  "fs-24":  { "$value": "1.5rem",    "$type": "dimension", "$description": "24 — h4" },
  "fs-28":  { "$value": "1.75rem",   "$type": "dimension", "$description": "28 — h3" },
  "fs-32":  { "$value": "2rem",      "$type": "dimension" },
  "fs-36":  { "$value": "2.25rem",   "$type": "dimension", "$description": "36 — h2" },
  "fs-44":  { "$value": "2.75rem",   "$type": "dimension" },
  "fs-56":  { "$value": "3.5rem",    "$type": "dimension", "$description": "56 — h1" },
  "fs-72":  { "$value": "4.5rem",    "$type": "dimension", "$description": "72 — display" },
  "fs-96":  { "$value": "6rem",      "$type": "dimension", "$description": "96 — hero display" },
  "fs-120": { "$value": "7.5rem",    "$type": "dimension", "$description": "120 — display XL" },

  "lh-display": { "$value": 0.95, "$type": "number" },
  "lh-tight":   { "$value": 1.05, "$type": "number" },
  "lh-snug":    { "$value": 1.2,  "$type": "number" },
  "lh-normal":  { "$value": 1.45, "$type": "number" },
  "lh-relaxed": { "$value": 1.6,  "$type": "number" },

  "ls-display": { "$value": "-0.035em", "$type": "dimension" },
  "ls-tight":   { "$value": "-0.02em",  "$type": "dimension" },
  "ls-snug":    { "$value": "-0.01em",  "$type": "dimension" },
  "ls-normal":  { "$value": "0",        "$type": "dimension" },
  "ls-loose":   { "$value": "0.04em",   "$type": "dimension" },
  "ls-wide":    { "$value": "0.12em",   "$type": "dimension" }
}
