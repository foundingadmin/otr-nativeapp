 "signalPrecedence": {
  "rule": "money > legal gate > outcome > info (§7.2 of the Cases PRD)",
  "implementedAs": [
   {
    "rank": 1,
    "when": "case.balance.overdue === true",
    "action": {
     "label": "Make a payment · $<amount>",
     "kind": "money",
     "icon": "bill-dollar-2"
    },
    "note": "Evaluated before status. Overrides every status action."
   },
   {
    "rank": 2,
    "when": "status === 'smartmatchd'",
    "action": {
     "label": "Accept or deny quote",
     "kind": "grad"
    }
   },
   {
    "rank": 2,
    "when": "status === 'almostgone'",
    "action": {
     "label": "Accept or deny now",
     "kind": "grad"
    }
   },
   {
    "rank": 2,
    "when": "status === 'expired'",
    "action": {
     "label": "Get SmartMatch'd",
     "kind": "primary",
     "icon": "triangle-arrow-synchronize-1"
    }
   },
   {
    "rank": 2,
    "when": "status === 'active-action'",
    "action": {
     "label": "Review & sign engagement",
     "kind": "primary",
     "icon": "file-edit"
    }
   },
   {
    "rank": 2,
    "when": "status === 'incomplete'",
    "action": {
     "label": "Complete booking",
     "kind": "primary"
    }
   },
   {
    "rank": 2,
    "when": "status === 'deadline'",
    "action": {
     "label": "Finish before court date",
     "kind": "primary"
    }
   },
   {
    "rank": 3,
    "when": "status === 'active' && unread",
    "action": {
     "label": "View update",
     "kind": "ghost"
    }
   },
   {
    "rank": 3,
    "when": "status === 'resolved' || status === 'dismissed'",
    "action": {
     "label": "Review your attorney",
     "kind": "ghost"
    }
   },
   {
    "rank": 4,
    "when": "anything else",
    "action": null,
    "note": "No action button. The card is calm."
   }
  ],
  "actionKinds": {
   "money": "--money fill, white label",
   "grad": "--otr-grad fill (SmartMatch'd sub-brand), white label",
   "primary": "--wf-ink fill, white label",
   "ghost": "white fill, --wf-line border, --wf-ink label",
   "blue": "--otr-blue fill, white label"
  }
 },
